from flask import Flask, request, jsonify

app = Flask(__name__)

@app.route('/customer')
def get_customer():
    # クエリパラメータからidを取得（使用しないがエンドポイントの仕様として）
    customer_id = request.args.get('id', '1')

    # 常に同じレスポンスを返す
    return jsonify({
        'id': 1,
        'name': '田中悟',
        'phone': '090-1111-1111'
    })

@app.route('/store-status')
def get_store_status():
    # 常に同じレスポンスを返す
    return jsonify({
        'status': 'closed'
    })

# Vercelのサーバーレス関数用のハンドラー
def handler(request):
    with app.request_context(request.environ):
        return app.full_dispatch_request()

# ローカル開発用
if __name__ == '__main__':
    app.run(debug=True, port=5000)
