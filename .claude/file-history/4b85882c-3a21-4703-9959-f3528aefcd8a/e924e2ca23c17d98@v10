let apiKey = null;

export const initializeOpenAI = (key) => {
  apiKey = key;
};

// 翻訳（非ストリーミング - React Nativeで安定動作）
export const translateTextStreaming = async (text, onChunk) => {
  if (!apiKey) {
    throw new Error('OpenAI API key not initialized');
  }

  return new Promise((resolve, reject) => {
    console.log('Making API request to OpenAI...');

    const xhr = new XMLHttpRequest();
    xhr.open('POST', 'https://api.openai.com/v1/chat/completions');
    xhr.setRequestHeader('Content-Type', 'application/json');
    xhr.setRequestHeader('Authorization', `Bearer ${apiKey}`);

    xhr.onload = () => {
      if (xhr.status >= 200 && xhr.status < 300) {
        try {
          const data = JSON.parse(xhr.responseText);
          const translation = data.choices[0].message.content;
          onChunk(translation);
          resolve(translation);
        } catch (error) {
          console.error('Parse error:', error);
          reject(error);
        }
      } else {
        console.error('API error:', xhr.responseText);
        reject(new Error(`API error: ${xhr.status} ${xhr.statusText}`));
      }
    };

    xhr.onerror = (error) => {
      console.error('Network error:', error);
      reject(new Error('Network request failed'));
    };

    xhr.ontimeout = () => {
      console.error('Request timeout');
      reject(new Error('Request timeout'));
    };

    xhr.timeout = 60000; // 60秒タイムアウト

    const requestBody = JSON.stringify({
      model: 'gpt-4o-mini',
      messages: [
        {
          role: 'system',
          content: 'You are a professional translator. Translate the following English text to Japanese. Provide ONLY the translation without any explanations.',
        },
        {
          role: 'user',
          content: text,
        },
      ],
      max_tokens: 1000,
      temperature: 0.3,
    });

    xhr.send(requestBody);
  });
};

// 通常の翻訳（フォールバック用）
export const translateText = async (text) => {
  return translateTextStreaming(text, () => {});
};
