let apiKey = null;

export const initializeOpenAI = (key) => {
  apiKey = key;
};

// ストリーミング翻訳（XMLHttpRequestでSSEを受信）
export const translateTextStreaming = async (text, onChunk) => {
  if (!apiKey) {
    throw new Error('OpenAI API key not initialized');
  }

  return new Promise((resolve, reject) => {
    console.log('Making streaming API request to OpenAI...');

    const xhr = new XMLHttpRequest();
    xhr.open('POST', 'https://api.openai.com/v1/chat/completions');
    xhr.setRequestHeader('Content-Type', 'application/json');
    xhr.setRequestHeader('Authorization', `Bearer ${apiKey}`);

    let fullTranslation = '';
    let lastProcessedIndex = 0;

    // ストリーミングデータを受信
    xhr.onprogress = () => {
      const responseText = xhr.responseText;
      const newData = responseText.substring(lastProcessedIndex);
      lastProcessedIndex = responseText.length;

      // SSE形式のデータをパース
      const lines = newData.split('\n');
      for (const line of lines) {
        if (line.startsWith('data: ')) {
          const data = line.substring(6);
          if (data === '[DONE]') continue;

          try {
            const parsed = JSON.parse(data);
            const content = parsed.choices[0]?.delta?.content;
            if (content) {
              fullTranslation += content;
              // リアルタイムで部分翻訳を返す（追加分のみ）
              onChunk(fullTranslation);
            }
          } catch (e) {
            // パースエラーは無視（不完全なデータの可能性）
          }
        }
      }
    };

    xhr.onload = () => {
      console.log('Response status:', xhr.status);

      if (xhr.status >= 200 && xhr.status < 300) {
        // ストリーミングではない場合の処理
        if (fullTranslation === '') {
          try {
            const data = JSON.parse(xhr.responseText);
            fullTranslation = data.choices[0].message.content;
            onChunk(fullTranslation);
          } catch (error) {
            console.error('Parse error:', error);
            reject(error);
            return;
          }
        }
        console.log('Translation successful');
        resolve(fullTranslation);
      } else {
        console.error('API error:', xhr.responseText);
        reject(new Error(`API error: ${xhr.status} ${xhr.statusText}`));
      }
    };

    xhr.onerror = (error) => {
      console.error('Network error:', error);
      reject(new Error('Network request failed'));
    };

    xhr.ontimeout = () => {
      console.error('Request timeout');
      reject(new Error('Request timeout'));
    };

    xhr.timeout = 60000; // 60秒タイムアウト

    const requestBody = JSON.stringify({
      model: 'gpt-4o-mini',
      messages: [
        {
          role: 'system',
          content: 'You are a professional translator. Translate the following English text to Japanese. Provide ONLY the translation without any explanations.',
        },
        {
          role: 'user',
          content: text,
        },
      ],
      max_tokens: 1000,
      temperature: 0.3,
      stream: true, // ストリーミングを有効化
    });

    console.log('Sending streaming request...');
    xhr.send(requestBody);
  });
};

// 通常の翻訳（フォールバック用）
export const translateText = async (text) => {
  return translateTextStreaming(text, () => {});
};
