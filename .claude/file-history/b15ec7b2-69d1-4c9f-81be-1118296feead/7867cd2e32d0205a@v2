* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background: #0a0a0a;
    color: #ffffff;
    overflow: hidden;
}

.video-container {
    width: 1920px;
    height: 1080px;
    position: relative;
    margin: 0 auto;
    background: linear-gradient(135deg, #0a0a0a 0%, #1a1a2e 100%);
    transform-origin: top left;
}

/* Responsive scaling */
@media (max-width: 1920px) {
    .video-container {
        transform: scale(0.9);
    }
}

@media (max-width: 1600px) {
    .video-container {
        transform: scale(0.7);
    }
}

/* Scenes */
.scene {
    position: absolute;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 1s ease, visibility 1s ease;
}

.scene.active {
    opacity: 1;
    visibility: visible;
}

/* Scene 1: Opening */
.logo-container {
    text-align: center;
}

.twilio-logo {
    font-size: 120px;
    font-weight: bold;
    margin-bottom: 40px;
    background: linear-gradient(135deg, #f22f46 0%, #ff6b6b 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.twilio-logo.large {
    font-size: 180px;
}

.logo-text {
    display: inline-block;
    animation: logoReveal 2s ease-out forwards;
}

.tagline {
    font-size: 48px;
    font-weight: 300;
    color: #ffffff;
    opacity: 0;
}

.website {
    font-size: 36px;
    color: #f22f46;
    margin-top: 30px;
    opacity: 0;
}

/* Scene 2: Problem Statement */
.content-center {
    text-align: center;
    max-width: 1400px;
    padding: 0 100px;
}

.content-center h2 {
    font-size: 64px;
    margin-bottom: 80px;
    color: #ffffff;
}

.problem-items {
    display: flex;
    justify-content: space-around;
    gap: 60px;
}

.problem-item {
    flex: 1;
    padding: 40px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 20px;
    border: 2px solid rgba(242, 47, 70, 0.3);
    opacity: 0;
    transform: translateY(50px);
}

.problem-item .icon {
    font-size: 80px;
    display: block;
    margin-bottom: 20px;
}

.problem-item p {
    font-size: 28px;
    line-height: 1.6;
}

/* Scene 3: Solution */
.solution-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px;
}

.solution-card {
    background: linear-gradient(135deg, rgba(242, 47, 70, 0.1) 0%, rgba(26, 26, 46, 0.5) 100%);
    padding: 50px;
    border-radius: 20px;
    border: 2px solid rgba(242, 47, 70, 0.3);
    opacity: 0;
    transform: scale(0.8);
    transition: transform 0.3s ease;
}

.solution-card:hover {
    transform: scale(1.05);
    border-color: #f22f46;
}

.card-icon {
    font-size: 80px;
    margin-bottom: 20px;
}

.solution-card h3 {
    font-size: 36px;
    margin-bottom: 15px;
    color: #f22f46;
}

.solution-card p {
    font-size: 24px;
    line-height: 1.6;
    color: #cccccc;
}

/* Scene 4: Features */
.features-list {
    max-width: 1200px;
    margin: 0 auto;
}

.feature-item {
    display: flex;
    align-items: center;
    margin-bottom: 50px;
    padding: 40px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 20px;
    border-left: 5px solid #f22f46;
    opacity: 0;
    transform: translateX(-100px);
}

.feature-number {
    font-size: 72px;
    font-weight: bold;
    color: #f22f46;
    margin-right: 40px;
    min-width: 120px;
}

.feature-content h3 {
    font-size: 36px;
    margin-bottom: 10px;
    color: #ffffff;
}

.feature-content p {
    font-size: 24px;
    color: #cccccc;
    line-height: 1.6;
}

/* Scene 5: Use Cases */
.use-cases {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px;
}

.use-case {
    background: rgba(255, 255, 255, 0.05);
    padding: 50px;
    border-radius: 20px;
    text-align: center;
    border: 2px solid rgba(242, 47, 70, 0.3);
    opacity: 0;
    transform: translateY(50px);
}

.use-case-icon {
    font-size: 100px;
    margin-bottom: 20px;
}

.use-case h3 {
    font-size: 36px;
    margin-bottom: 15px;
    color: #f22f46;
}

.use-case p {
    font-size: 24px;
    color: #cccccc;
    line-height: 1.6;
}

/* Scene 6: CTA */
.cta-subtitle {
    font-size: 32px;
    color: #cccccc;
    margin-bottom: 60px;
    opacity: 0;
}

.cta-buttons {
    display: flex;
    gap: 30px;
    justify-content: center;
    margin-bottom: 80px;
    opacity: 0;
    transform: translateY(30px);
}

.btn-primary,
.btn-secondary {
    padding: 25px 60px;
    font-size: 28px;
    border: none;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.3s ease;
    font-weight: 600;
}

.btn-primary {
    background: linear-gradient(135deg, #f22f46 0%, #ff6b6b 100%);
    color: white;
}

.btn-primary:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(242, 47, 70, 0.5);
}

.btn-secondary {
    background: transparent;
    color: #f22f46;
    border: 3px solid #f22f46;
}

.btn-secondary:hover {
    background: rgba(242, 47, 70, 0.1);
    transform: translateY(-5px);
}

.trusted-by {
    opacity: 0;
}

.trusted-by p {
    font-size: 24px;
    color: #cccccc;
    margin-bottom: 30px;
}

.company-logos {
    display: flex;
    justify-content: center;
    gap: 60px;
}

.company-logos span {
    font-size: 32px;
    font-weight: 600;
    color: #666;
}

/* Animations */
@keyframes logoReveal {
    0% {
        opacity: 0;
        transform: scale(0.5) rotate(-10deg);
    }
    100% {
        opacity: 1;
        transform: scale(1) rotate(0deg);
    }
}

.fade-in {
    animation: fadeIn 1.5s ease forwards;
}

@keyframes fadeIn {
    from {
        opacity: 0;
    }
    to {
        opacity: 1;
    }
}

.fade-in-up {
    animation: fadeInUp 1s ease forwards;
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(50px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.slide-in {
    animation: slideIn 1s ease forwards;
}

@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateX(-100px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

.slide-in-left {
    animation: slideInLeft 0.8s ease forwards;
}

@keyframes slideInLeft {
    from {
        opacity: 0;
        transform: translateX(-100px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

.pulse {
    animation: pulse 2s infinite;
}

@keyframes pulse {
    0%, 100% {
        transform: scale(1);
    }
    50% {
        transform: scale(1.05);
    }
}

/* Delays */
.delay-1 { animation-delay: 0.5s; }
.delay-2 { animation-delay: 1s; }
.delay-3 { animation-delay: 1.5s; }
.delay-4 { animation-delay: 2s; }

/* Progress Bar */
.progress-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 8px;
    background: rgba(255, 255, 255, 0.1);
    z-index: 1000;
}

.progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #f22f46 0%, #ff6b6b 100%);
    width: 0%;
    transition: width 0.3s ease;
}

/* Controls */
.controls {
    position: fixed;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 20px;
    z-index: 1001;
    background: rgba(0, 0, 0, 0.8);
    padding: 20px 40px;
    border-radius: 50px;
    backdrop-filter: blur(10px);
}

.control-btn {
    padding: 15px 30px;
    font-size: 18px;
    background: rgba(242, 47, 70, 0.2);
    color: white;
    border: 2px solid #f22f46;
    border-radius: 30px;
    cursor: pointer;
    transition: all 0.3s ease;
}

.control-btn:hover {
    background: #f22f46;
    transform: translateY(-3px);
}

.control-btn:active {
    transform: translateY(0);
}
