def main():
    """メイン処理"""
    print("🎬 Twilio マーケティング動画を生成中...")
    print("=" * 60)

    # 各シーンを作成
    scenes = []

    print("📹 シーン1: オープニング")
    scene1 = create_scene_1_opening(duration=4).fadeout(0.5)
    scenes.append(scene1)

    print("📹 シーン2: 課題提起")
    scene2 = create_scene_2_problem(duration=6).fadeout(0.5)
    scenes.append(scene2)

    print("📹 シーン3: ソリューション")
    scene3 = create_scene_3_solution(duration=7).fadeout(0.5)
    scenes.append(scene3)

    print("📹 シーン4: 選ばれる理由")
    scene4 = create_scene_4_features(duration=8).fadeout(0.5)
    scenes.append(scene4)

    print("📹 シーン5: 活用シーン")
    scene5 = create_scene_5_use_cases(duration=6).fadeout(0.5)
    scenes.append(scene5)

    print("📹 シーン6: CTA")
    scene6 = create_scene_6_cta(duration=7).fadeout(0.5)
    scenes.append(scene6)

    print("📹 シーン7: クロージング")
    scene7 = create_scene_7_closing(duration=5).fadeout(1)
    scenes.append(scene7)

    # 全シーンを結合
    print("\n🎞️ シーンを結合中...")
    final_video = concatenate_videoclips(scenes, method="compose")

    # 動画を出力
    output_file = "twilio_marketing_video.mp4"
    print(f"\n💾 動画を出力中: {output_file}")
    print("⏳ これには数分かかる場合があります...")

    final_video.write_videofile(
        output_file,
        fps=FPS,
        codec='libx264',
        audio=False,
        preset='medium',
        threads=4
    )

    print("\n" + "=" * 60)
    print(f"✅ 完了！動画を保存しました: {output_file}")
    print(f"📊 総時間: {final_video.duration:.1f}秒")
    print(f"📐 解像度: {WIDTH}x{HEIGHT}")
    print(f"🎬 FPS: {FPS}")
    print("=" * 60)

if __name__ == "__main__":
    main()
