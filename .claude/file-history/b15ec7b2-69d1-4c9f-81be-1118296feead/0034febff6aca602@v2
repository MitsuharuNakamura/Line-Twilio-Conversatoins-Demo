WHITE = (255, 255, 255)
GRAY = (200, 200, 200)

def create_gradient_background(duration, color1=(10, 10, 10), color2=(26, 26, 46)):
    """グラデーション背景を作成"""
    def make_frame(t):
        # 上から下へのグラデーション
        gradient = np.zeros((HEIGHT, WIDTH, 3), dtype=np.uint8)
        for y in range(HEIGHT):
            ratio = y / HEIGHT
            r = int(color1[0] * (1 - ratio) + color2[0] * ratio)
            g = int(color1[1] * (1 - ratio) + color2[1] * ratio)
            b = int(color1[2] * (1 - ratio) + color2[2] * ratio)
            gradient[y, :] = [r, g, b]
        return gradient

    return VideoClip(make_frame, duration=duration)

def create_text_clip(text, fontsize=70, color='white', duration=3,
                     position='center', font='Arial-Bold'):
    """テキストクリップを作成"""
    try:
        txt = TextClip(
            text,
            fontsize=fontsize,
            color=color,
            font=font,
            size=(WIDTH - 200, None),
            method='caption',
            align='center'
        )
    except:
        # フォントが見つからない場合はデフォルトを使用
        txt = TextClip(
            text,
            fontsize=fontsize,
            color=color,
            size=(WIDTH - 200, None),
            method='caption',
            align='center'
        )

    txt = txt.set_duration(duration).set_position(position)
    return txt

