import { useState, useEffect, useRef } from 'react';
import Voice from '@react-native-voice/voice';

export const useSpeechRecognition = () => {
  const [isListening, setIsListening] = useState(false);
  const [recognizedText, setRecognizedText] = useState('');
  const [partialText, setPartialText] = useState('');
  const [error, setError] = useState(null);
  const [completedSentences, setCompletedSentences] = useState([]);

  const lastUpdateTimeRef = useRef(Date.now());
  const silenceTimerRef = useRef(null);
  const accumulatedTextRef = useRef('');

  useEffect(() => {
    // 音声認識イベントリスナーの設定
    Voice.onSpeechStart = onSpeechStart;
    Voice.onSpeechEnd = onSpeechEnd;
    Voice.onSpeechError = onSpeechError;
    Voice.onSpeechResults = onSpeechResults;
    Voice.onSpeechPartialResults = onSpeechPartialResults;

    return () => {
      Voice.destroy().then(Voice.removeAllListeners);
    };
  }, []);

  const onSpeechStart = () => {
    setIsListening(true);
    setError(null);
  };

  const onSpeechEnd = () => {
    setIsListening(false);
  };

  const onSpeechError = (e) => {
    setError(e.error);
    setIsListening(false);
  };

  const onSpeechResults = (e) => {
    if (e.value && e.value.length > 0) {
      setRecognizedText(e.value[0]);
      setPartialText('');
    }
  };

  const onSpeechPartialResults = (e) => {
    if (e.value && e.value.length > 0) {
      const currentText = e.value[0];
      setPartialText(currentText);

      // 無音検出タイマーをリセット
      const now = Date.now();
      const timeSinceLastUpdate = now - lastUpdateTimeRef.current;
      lastUpdateTimeRef.current = now;

      // 前回のタイマーをクリア
      if (silenceTimerRef.current) {
        clearTimeout(silenceTimerRef.current);
      }

      // 0.8秒間更新がなければ文の区切りと判断
      silenceTimerRef.current = setTimeout(() => {
        const newText = currentText.trim();
        const accumulated = accumulatedTextRef.current;

        // 新しいテキストがあり、まだ処理されていない場合
        if (newText && newText !== accumulated) {
          console.log('Sentence completed by silence:', newText);
          accumulatedTextRef.current = newText;
          setCompletedSentences(prev => [...prev, newText]);
          setRecognizedText(newText);
        }
      }, 800);
    }
  };

  const startListening = async () => {
    try {
      setRecognizedText('');
      setPartialText('');
      setError(null);
      setCompletedSentences([]);
      accumulatedTextRef.current = '';
      lastUpdateTimeRef.current = Date.now();

      // 英語音声認識を開始（連続認識モード）
      await Voice.start('en-US', {
        EXTRA_PARTIAL_RESULTS: true,
        EXTRA_SPEECH_INPUT_MINIMUM_LENGTH_MILLIS: 0,
        EXTRA_SPEECH_INPUT_COMPLETE_SILENCE_LENGTH_MILLIS: 1000,
      });
    } catch (e) {
      setError(e.message);
    }
  };

  const stopListening = async () => {
    try {
      // タイマーをクリア
      if (silenceTimerRef.current) {
        clearTimeout(silenceTimerRef.current);
      }

      await Voice.stop();
      setIsListening(false);
    } catch (e) {
      setError(e.message);
    }
  };

  return {
    isListening,
    recognizedText,
    partialText,
    error,
    completedSentences,
    startListening,
    stopListening,
  };
};
