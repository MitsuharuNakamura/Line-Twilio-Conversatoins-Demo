import React, { useState, useEffect, useRef } from 'react';
import {
  StyleSheet,
  Text,
  View,
  TouchableOpacity,
  ScrollView,
  SafeAreaView,
  ActivityIndicator,
  Alert,
  Platform,
} from 'react-native';
import { StatusBar } from 'expo-status-bar';
import { LinearGradient } from 'expo-linear-gradient';
import { useSpeechRecognition } from './src/hooks/useSpeechRecognition';
import { initializeOpenAI, translateTextStreaming } from './src/services/translationService';
import { OPENAI_API_KEY } from '@env';

export default function App() {
  const [translatedText, setTranslatedText] = useState('');
  const [isTranslating, setIsTranslating] = useState(false);
  const [lastProcessedIndex, setLastProcessedIndex] = useState(0);

  const englishScrollViewRef = useRef(null);
  const japaneseScrollViewRef = useRef(null);
  const translationQueueRef = useRef([]);
  const isProcessingQueueRef = useRef(false);

  const {
    isListening,
    recognizedText,
    partialText,
    error,
    completedSentences,
    startListening,
    stopListening,
  } = useSpeechRecognition();


  // OpenAI初期化とネットワークテスト
  useEffect(() => {
    console.log('API Key check:', OPENAI_API_KEY ? 'Found' : 'Not found');

    // ネットワーク接続テスト
    const testNetwork = async () => {
      try {
        console.log('Testing network connection...');
        const xhr = new XMLHttpRequest();
        xhr.open('GET', 'https://www.google.com');
        xhr.onload = () => {
          console.log('Network test success - Google reachable');
        };
        xhr.onerror = (e) => {
          console.log('Network test failed - Cannot reach Google', e);
        };
        xhr.send();
      } catch (error) {
        console.log('Network test error:', error);
      }
    };

    testNetwork();

    if (OPENAI_API_KEY) {
      initializeOpenAI(OPENAI_API_KEY);
      console.log('OpenAI initialized');
    } else {
      Alert.alert('エラー', '.envファイルにOPENAI_API_KEYを設定してください');
    }
  }, []);

  // completedSentencesが更新されたら翻訳
  useEffect(() => {
    if (completedSentences.length > lastProcessedIndex) {
      // 新しく完成した文を取得
      const newSentences = completedSentences.slice(lastProcessedIndex);

      newSentences.forEach((sentence) => {
        if (sentence.trim()) {
          console.log('New completed sentence:', sentence);
          handleTranslateSentence(sentence);
        }
      });

      setLastProcessedIndex(completedSentences.length);
    }
  }, [completedSentences]);

  const processTranslationQueue = async () => {
    if (isProcessingQueueRef.current || translationQueueRef.current.length === 0) {
      return;
    }

    isProcessingQueueRef.current = true;
    setIsTranslating(true);

    while (translationQueueRef.current.length > 0) {
      const sentenceText = translationQueueRef.current.shift();

      try {
        console.log('Translating from queue:', sentenceText);
        const translation = await translateTextStreaming(sentenceText, () => {});

        // 翻訳を蓄積して表示（既存の翻訳に追加）
        setTranslatedText(prev => {
          const newText = prev + (prev ? ' ' : '') + translation;
          // 翻訳が更新されたら自動スクロール
          setTimeout(() => {
            japaneseScrollViewRef.current?.scrollToEnd({ animated: true });
          }, 100);
          return newText;
        });

        console.log('Translated and appended:', translation);
      } catch (err) {
        console.error('Translation error:', err);
      }
    }

    isProcessingQueueRef.current = false;
    setIsTranslating(false);
  };

  const handleTranslateSentence = async (sentenceText) => {
    if (!sentenceText) {
      return;
    }

    // キューに追加
    translationQueueRef.current.push(sentenceText);
    console.log('Added to queue. Queue length:', translationQueueRef.current.length);

    // キュー処理を開始
    processTranslationQueue();
  };

  // 英語の文字起こしが更新されたら自動スクロール
  useEffect(() => {
    if (recognizedText) {
      setTimeout(() => {
        englishScrollViewRef.current?.scrollToEnd({ animated: true });
      }, 100);
    }
  }, [recognizedText]);

  const handleMicPress = () => {
    if (isListening) {
      stopListening();
    } else {
      // 新しい録音開始時にリセット
      setTranslatedText('');
      setLastProcessedIndex(0);
      translationQueueRef.current = [];
      isProcessingQueueRef.current = false;
      startListening();
    }
  };

  const displayText = recognizedText || 'Tap to speak...';

  return (
    <View style={styles.container}>
      <StatusBar style="light" />

      <LinearGradient
        colors={['#1a1a2e', '#16213e', '#0f3460']}
        style={styles.gradient}
      >
        {/* ヘッダー */}
        <View style={styles.header}>
          <Text style={styles.headerTitle}>Realtime Translation</Text>
          <View style={styles.languageBadge}>
            <Text style={styles.badgeText}>EN → JA</Text>
          </View>
        </View>

        {/* メインコンテンツ */}
        <View style={styles.mainContent}>
          {/* 英語表示エリア */}
          <View style={styles.glassCard}>
            <View style={styles.cardHeader}>
              <Text style={styles.cardTitle}>English</Text>
              {isListening && <View style={styles.recordingIndicator} />}
            </View>
            <ScrollView
              ref={englishScrollViewRef}
              style={styles.textScrollView}
            >
              <Text style={[styles.text, partialText && styles.partialText]}>
                {isListening ? displayText : recognizedText || 'Waiting for input...'}
              </Text>
            </ScrollView>
          </View>

          {/* 翻訳表示エリア */}
          <View style={styles.glassCard}>
            <View style={styles.cardHeader}>
              <Text style={styles.cardTitle}>日本語</Text>
              {isTranslating && <ActivityIndicator size="small" color="#60a5fa" />}
            </View>
            <ScrollView
              ref={japaneseScrollViewRef}
              style={styles.textScrollView}
            >
              <Text style={styles.text}>{translatedText || '翻訳待機中...'}</Text>
            </ScrollView>
          </View>
        </View>

        {/* コントロールボタン */}
        <View style={styles.controls}>
          <TouchableOpacity
            style={[styles.micButton, isListening && styles.micButtonActive]}
            onPress={handleMicPress}
            activeOpacity={0.8}
          >
            <View style={styles.micButtonInner}>
              <Text style={styles.micIcon}>{isListening ? '⏸' : '●'}</Text>
              <Text style={styles.micButtonText}>{isListening ? 'Stop' : 'Speak'}</Text>
            </View>
          </TouchableOpacity>

          {error && (
            <View style={styles.errorContainer}>
              <Text style={styles.errorText}>{error}</Text>
            </View>
          )}
        </View>
      </LinearGradient>
    </View>
  );
}

