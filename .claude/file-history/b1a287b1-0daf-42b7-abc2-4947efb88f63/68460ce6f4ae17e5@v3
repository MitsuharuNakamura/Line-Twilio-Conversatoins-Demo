import SwiftUI
import SwiftData

struct MainView: View {
    @StateObject var newsViewModel: NewsViewModel
    @State private var selectedArticle: Article?

    var body: some View {
        NavigationStack {
            VStack(spacing: 0) {
                // カテゴリ選択
                Picker("カテゴリ", selection: Binding(
                    get: { newsViewModel.selectedCategory },
                    set: { newsViewModel.changeCategory($0) }
                )) {
                    ForEach(Category.allCases) { category in
                        Text(category.rawValue).tag(category)
                    }
                }
                .pickerStyle(.menu)
                .padding(.horizontal)
                .padding(.vertical, 8)

                Divider()

                // カードスタック
                ZStack {
                    if newsViewModel.isLoading && newsViewModel.articles.isEmpty {
                        VStack(spacing: 16) {
                            ProgressView()
                                .scaleEffect(1.5)
                            Text("読み込み中...")
                                .foregroundColor(.secondary)
                        }
                    } else if let errorMessage = newsViewModel.errorMessage {
                        VStack(spacing: 16) {
                            Image(systemName: "exclamationmark.triangle")
                                .font(.system(size: 50))
                                .foregroundColor(.orange)
                            Text(errorMessage)
                                .foregroundColor(.secondary)
                            Button("再試行") {
                                Task {
                                    await newsViewModel.loadArticles()
                                }
                            }
                            .buttonStyle(.borderedProminent)
                        }
                        .padding()
                    } else {
                        CardStackView(
                            articles: newsViewModel.articles,
                            onSwipe: { article, action in
                                newsViewModel.handleSwipe(article: article, action: action)
                            },
                            onCardTap: { article in
                                selectedArticle = article
                            }
                        )
                    }
                }
                .frame(maxWidth: .infinity, maxHeight: .infinity)

                // スワイプヒント
                if !newsViewModel.articles.isEmpty {
                    HStack(spacing: 40) {
                        VStack(spacing: 8) {
                            Image(systemName: "hand.thumbsdown.fill")
                                .foregroundColor(.red)
                            Text("左スワイプ")
                                .font(.caption)
                                .foregroundColor(.secondary)
                            Text("スキップ")
                                .font(.caption2)
                                .foregroundColor(.secondary)
                        }

                        VStack(spacing: 8) {
                            Image(systemName: "hand.tap.fill")
                                .foregroundColor(.blue)
                            Text("タップ")
                                .font(.caption)
                                .foregroundColor(.secondary)
                            Text("詳細表示")
                                .font(.caption2)
                                .foregroundColor(.secondary)
                        }

                        VStack(spacing: 8) {
                            Image(systemName: "hand.thumbsup.fill")
                                .foregroundColor(.green)
                            Text("右スワイプ")
                                .font(.caption)
                                .foregroundColor(.secondary)
                            Text("既読")
                                .font(.caption2)
                                .foregroundColor(.secondary)
                        }
                    }
                    .padding(.vertical, 16)
                }
            }
            .navigationTitle("NewsSwipe")
            .navigationBarTitleDisplayMode(.inline)
            .sheet(item: $selectedArticle) { article in
                ArticleDetailView(article: article)
            }
        }
        .task {
            if newsViewModel.articles.isEmpty {
                await newsViewModel.loadArticles()
            }
        }
    }
}

