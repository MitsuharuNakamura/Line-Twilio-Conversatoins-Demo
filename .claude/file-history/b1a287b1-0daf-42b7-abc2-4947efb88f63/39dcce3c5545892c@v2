import Foundation
import SwiftData

@MainActor
class HistoryViewModel: ObservableObject {
    private let modelContext: ModelContext

    init(modelContext: ModelContext) {
        self.modelContext = modelContext
    }

    func addHistory(articleId: UUID, action: SwipeAction) {
        let history = ReadHistory(articleId: articleId, action: action)
        modelContext.insert(history)

        do {
            try modelContext.save()
        } catch {
            print("Failed to save history: \(error)")
        }
    }

    func cleanupOldHistory() {
        let oneWeekAgo = Calendar.current.date(byAdding: .day, value: -7, to: Date()) ?? Date()

        let descriptor = FetchDescriptor<ReadHistory>(
            predicate: #Predicate { $0.timestamp < oneWeekAgo }
        )

        do {
            let oldHistories = try modelContext.fetch(descriptor)
            for history in oldHistories {
                modelContext.delete(history)
            }
            try modelContext.save()
            print("Cleaned up \(oldHistories.count) old history entries")
        } catch {
            print("Failed to cleanup old history: \(error)")
        }
    }

    func isArticleRead(articleId: UUID) -> Bool {
        let descriptor = FetchDescriptor<ReadHistory>(
            predicate: #Predicate { $0.articleId == articleId }
        )

        do {
            let histories = try modelContext.fetch(descriptor)
            return !histories.isEmpty
        } catch {
            return false
        }
    }
}
