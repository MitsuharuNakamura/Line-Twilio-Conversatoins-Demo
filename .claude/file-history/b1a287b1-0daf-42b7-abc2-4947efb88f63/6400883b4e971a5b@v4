import Foundation
import FeedKit

class RSSService {
    func fetchAllRSS(category: Category) async throws -> [Article] {
        var allArticles: [Article] = []

        // 各RSSソースから並列で取得
        await withTaskGroup(of: [Article].self) { group in
            for rssURL in category.rssURLs {
                group.addTask {
                    do {
                        print("🔄 Fetching from: \(rssURL)")
                        let articles = try await self.fetchRSS(from: rssURL, category: category)
                        print("✅ Fetched \(articles.count) articles from \(rssURL)")
                        return articles
                    } catch {
                        print("❌ Failed to fetch from \(rssURL): \(error)")
                        return []
                    }
                }
            }

            for await articles in group {
                allArticles.append(contentsOf: articles)
            }
        }

        return allArticles
    }

    private func fetchRSS(from urlString: String, category: Category) async throws -> [Article] {
        guard let url = URL(string: urlString) else {
            throw RSSError.invalidURL
        }

        return try await withCheckedThrowingContinuation { continuation in
            let parser = FeedParser(URL: url)

            parser.parseAsync { result in
                switch result {
                case .success(let feed):
                    let articles = self.parseRSSFeed(feed, category: category, sourceURL: urlString)
                    continuation.resume(returning: articles)

                case .failure(let error):
                    continuation.resume(throwing: error)
                }
            }
        }
    }

    private func parseRSSFeed(_ feed: Feed, category: Category, sourceURL: String) -> [Article] {
        var articles: [Article] = []
        let sourceName = getSourceName(from: sourceURL)

        switch feed {
        case .rss(let rssFeed):
            articles = rssFeed.items?.compactMap { item in
                guard let title = item.title,
                      let link = item.link else {
                    return nil
                }

                // 画像URLを複数のソースから取得
                var imageURL: String? = item.enclosure?.attributes?.url

                if imageURL == nil {
                    imageURL = item.media?.mediaContents?.first?.attributes?.url
                }

                if imageURL == nil {
                    imageURL = item.media?.mediaThumbnails?.first?.attributes?.url
                }

                // description内のimg tagから抽出
                if imageURL == nil, let description = item.description {
                    imageURL = extractImageURL(from: description)
                }

                // content:encodedから抽出
                if imageURL == nil, let content = item.content?.contentEncoded {
                    imageURL = extractImageURL(from: content)
                }

                // 画像がない場合はカテゴリのデフォルト画像を使用
                let finalImageURL = imageURL ?? category.defaultImageURL

                return Article(
                    title: title,
                    summary: item.description?.stripHTML() ?? "詳細は記事をご覧ください",
                    imageURL: finalImageURL,
                    articleURL: link,
                    sourceName: item.source?.value ?? rssFeed.title ?? sourceName,
                    publishedDate: item.pubDate ?? Date(),
                    category: category
                )
            } ?? []

        case .atom(let atomFeed):
            articles = atomFeed.entries?.compactMap { entry in
                guard let title = entry.title,
                      let link = entry.links?.first?.attributes?.href else {
                    return nil
                }

                var imageURL: String?

                // content内のimg tagから抽出
                if let content = entry.content?.value {
                    imageURL = extractImageURL(from: content)
                }

                if imageURL == nil, let summary = entry.summary?.value {
                    imageURL = extractImageURL(from: summary)
                }

                // 画像がない場合はカテゴリのデフォルト画像を使用
                let finalImageURL = imageURL ?? category.defaultImageURL

                return Article(
                    title: title,
                    summary: entry.summary?.value?.stripHTML() ?? "詳細は記事をご覧ください",
                    imageURL: finalImageURL,
                    articleURL: link,
                    sourceName: atomFeed.title ?? sourceName,
                    publishedDate: entry.published ?? Date(),
                    category: category
                )
            } ?? []

        case .json:
            break
        }

        return articles
    }

    private func extractImageURL(from html: String) -> String? {
        // <img src="..." パターンを検索
        let pattern = "<img[^>]+src=\"([^\"]+)\""

        if let regex = try? NSRegularExpression(pattern: pattern, options: .caseInsensitive) {
            let range = NSRange(html.startIndex..., in: html)
            if let match = regex.firstMatch(in: html, range: range),
               let imgRange = Range(match.range(at: 1), in: html) {
                return String(html[imgRange])
            }
        }

        return nil
    }

    private func getSourceName(from url: String) -> String {
        if url.contains("yahoo.co.jp") {
            return "Yahoo!ニュース"
        } else if url.contains("itmedia.co.jp") {
            return "ITmedia"
        } else if url.contains("gigazine.net") {
            return "GIGAZINE"
        } else if url.contains("hatena.ne.jp") {
            return "はてなブックマーク"
        } else if url.contains("google.com") {
            return "Google News"
        } else {
            return "ニュース"
        }
    }
}

enum RSSError: Error {
    case invalidURL
    case parsingError
}

// MARK: - String Extension

extension String {
    func stripHTML() -> String {
        return self.replacingOccurrences(of: "<[^>]+>", with: "", options: .regularExpression, range: nil)
            .trimmingCharacters(in: .whitespacesAndNewlines)
    }
}
