import Foundation
import FeedKit

class RSSService {
    func fetchGoogleNewsRSS(category: Category) async throws -> [Article] {
        guard let url = URL(string: category.googleNewsRSSURL) else {
            throw RSSError.invalidURL
        }

        return try await withCheckedThrowingContinuation { continuation in
            let parser = FeedParser(URL: url)

            parser.parseAsync { result in
                switch result {
                case .success(let feed):
                    let articles = self.parseRSSFeed(feed, category: category)
                    continuation.resume(returning: articles)

                case .failure(let error):
                    continuation.resume(throwing: error)
                }
            }
        }
    }

    private func parseRSSFeed(_ feed: Feed, category: Category) -> [Article] {
        var articles: [Article] = []

        switch feed {
        case .rss(let rssFeed):
            articles = rssFeed.items?.compactMap { item in
                guard let title = item.title,
                      let link = item.link else {
                    return nil
                }

                // 画像URLを複数のソースから取得
                var imageURL: String? = item.enclosure?.attributes?.url

                if imageURL == nil {
                    imageURL = item.media?.mediaContents?.first?.attributes?.url
                }

                if imageURL == nil {
                    imageURL = item.media?.mediaThumbnails?.first?.attributes?.url
                }

                // description内のimg tagから抽出
                if imageURL == nil, let description = item.description {
                    imageURL = extractImageURL(from: description)
                }

                // content:encodedから抽出
                if imageURL == nil, let content = item.content?.contentEncoded {
                    imageURL = extractImageURL(from: content)
                }

                if imageURL == nil {
                    print("⚠️ No image found for: \(title.prefix(50))...")
                } else {
                    print("🖼️ Image found: \(imageURL!.prefix(80))...")
                }

                return Article(
                    title: title,
                    summary: item.description?.stripHTML() ?? "詳細は記事をご覧ください",
                    imageURL: imageURL,
                    articleURL: link,
                    sourceName: item.source?.value ?? rssFeed.title ?? "Google News",
                    publishedDate: item.pubDate ?? Date(),
                    category: category
                )
            } ?? []

        case .atom(let atomFeed):
            articles = atomFeed.entries?.compactMap { entry in
                guard let title = entry.title,
                      let link = entry.links?.first?.attributes?.href else {
                    return nil
                }

                var imageURL: String?

                // content内のimg tagから抽出
                if let content = entry.content?.value {
                    imageURL = extractImageURL(from: content)
                }

                if imageURL == nil, let summary = entry.summary?.value {
                    imageURL = extractImageURL(from: summary)
                }

                return Article(
                    title: title,
                    summary: entry.summary?.value?.stripHTML() ?? "詳細は記事をご覧ください",
                    imageURL: imageURL,
                    articleURL: link,
                    sourceName: atomFeed.title ?? "Google News",
                    publishedDate: entry.published ?? Date(),
                    category: category
                )
            } ?? []

        case .json:
            break
        }

        return articles
    }

    private func extractImageURL(from html: String) -> String? {
        // <img src="..." パターンを検索
        let pattern = "<img[^>]+src=\"([^\"]+)\""

        if let regex = try? NSRegularExpression(pattern: pattern, options: .caseInsensitive) {
            let range = NSRange(html.startIndex..., in: html)
            if let match = regex.firstMatch(in: html, range: range),
               let imgRange = Range(match.range(at: 1), in: html) {
                return String(html[imgRange])
            }
        }

        return nil
    }
}

enum RSSError: Error {
    case invalidURL
    case parsingError
}

// MARK: - String Extension

extension String {
    func stripHTML() -> String {
        return self.replacingOccurrences(of: "<[^>]+>", with: "", options: .regularExpression, range: nil)
            .trimmingCharacters(in: .whitespacesAndNewlines)
    }
}
