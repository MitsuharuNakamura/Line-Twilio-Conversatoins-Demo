import Foundation
import SwiftUI

@MainActor
class NewsViewModel: ObservableObject {
    @Published var articles: [Article] = []
    @Published var selectedCategory: Category = .technology
    @Published var isLoading: Bool = false
    @Published var errorMessage: String?

    private let historyViewModel: HistoryViewModel
    private let newsService: NewsService

    init(historyViewModel: HistoryViewModel, newsAPIKey: String? = nil) {
        self.historyViewModel = historyViewModel
        self.newsService = NewsService(newsAPIKey: newsAPIKey)
    }

    func loadArticles() async {
        isLoading = true
        errorMessage = nil

        do {
            // 実際のニュースを取得
            let fetchedArticles = try await newsService.fetchArticles(for: selectedCategory)

            if fetchedArticles.isEmpty {
                // データがない場合はモックを表示
                articles = Article.mockArray(count: 10, category: selectedCategory)
            } else {
                articles = fetchedArticles
            }

            isLoading = false
        } catch {
            // エラー時はモックデータを表示
            print("Failed to load articles: \(error)")
            articles = Article.mockArray(count: 10, category: selectedCategory)
            isLoading = false
        }
    }

    func handleSwipe(article: Article, action: SwipeAction) {
        // 履歴に保存
        historyViewModel.addHistory(articleId: article.id, action: action)

        // カードスタックから削除
        if let index = articles.firstIndex(where: { $0.id == article.id }) {
            articles.remove(at: index)
        }

        // 残り3枚以下になったら追加読み込み
        if articles.count <= 3 {
            Task {
                await loadArticles()
            }
        }
    }

    func changeCategory(_ category: Category) {
        selectedCategory = category
        articles = []
        Task {
            await loadArticles()
        }
    }
}
