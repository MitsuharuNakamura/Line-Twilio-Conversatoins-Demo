import SwiftUI

struct ContentView: View {
    @StateObject private var translationViewModel = TranslationViewModel()
    @Environment(\.horizontalSizeClass) var horizontalSizeClass
    @Environment(\.verticalSizeClass) var verticalSizeClass

    // デバイスの向きを判定
    var isLandscape: Bool {
        horizontalSizeClass == .regular || verticalSizeClass == .compact
    }

    var body: some View {
        GeometryReader { geometry in
            VStack(spacing: 0) {
                // Header - コンパクトに
                Text("リアルタイム音声翻訳")
                    .font(.headline)
                    .fontWeight(.bold)
                    .padding(.vertical, 8)
                    .padding(.horizontal)
                    .frame(maxWidth: .infinity)
                    .background(Color(.systemBackground))

                // Translation Display Area - 画面の大部分を使用
                if isLandscape {
                    // 横向き: 横並びレイアウト
                    HStack(spacing: 8) {
                        TranslationTextView(
                            title: "English",
                            text: translationViewModel.recognizedText.isEmpty ? "音声を認識中..." : translationViewModel.recognizedText,
                            color: .blue,
                            height: geometry.size.height - 120
                        )

                        TranslationTextView(
                            title: "日本語",
                            text: translationViewModel.translatedText.isEmpty ? "翻訳を待機中..." : translationViewModel.translatedText,
                            color: .green,
                            height: geometry.size.height - 120
                        )
                    }
                    .padding(.horizontal, 8)
                    .padding(.bottom, 4)
                } else {
                    // 縦向き: 縦並びレイアウト
                    let availableHeight = geometry.size.height - 120 // ヘッダーとボタンを除く
                    let historyHeight: CGFloat = translationViewModel.history.isEmpty ? 0 : 100
                    let textViewHeight = (availableHeight - historyHeight) / 2

                    VStack(spacing: 8) {
                        TranslationTextView(
                            title: "English",
                            text: translationViewModel.recognizedText.isEmpty ? "音声を認識中..." : translationViewModel.recognizedText,
                            color: .blue,
                            height: textViewHeight
                        )

                        TranslationTextView(
                            title: "日本語",
                            text: translationViewModel.translatedText.isEmpty ? "翻訳を待機中..." : translationViewModel.translatedText,
                            color: .green,
                            height: textViewHeight
                        )

                        // Translation History
                        if !translationViewModel.history.isEmpty {
                            VStack(alignment: .leading, spacing: 4) {
                                Text("翻訳履歴")
                                    .font(.caption)
                                    .fontWeight(.semibold)
                                    .padding(.horizontal, 12)
                                    .padding(.top, 4)

                                ScrollView {
                                    VStack(alignment: .leading, spacing: 4) {
                                        ForEach(translationViewModel.history) { item in
                                            VStack(alignment: .leading, spacing: 2) {
                                                Text(item.originalText)
                                                    .font(.caption2)
                                                    .foregroundColor(.secondary)
                                                Text(item.translatedText)
                                                    .font(.caption)
                                                Divider()
                                            }
                                            .padding(.vertical, 2)
                                        }
                                    }
                                    .padding(.horizontal, 12)
                                }
                            }
                            .frame(height: historyHeight)
                            .background(Color(.systemGray6))
                            .cornerRadius(10)
                            .padding(.horizontal, 8)
                        }
                    }
                    .padding(.horizontal, 8)
                    .padding(.bottom, 4)
                }

                // Control Buttons - コンパクトに
                HStack(spacing: 20) {
                    Button(action: {
                        if translationViewModel.isRecording {
                            translationViewModel.stopRecording()
                        } else {
                            translationViewModel.startRecording()
                        }
                    }) {
                        Image(systemName: translationViewModel.isRecording ? "stop.circle.fill" : "mic.circle.fill")
                            .font(.system(size: 50))
                            .foregroundColor(translationViewModel.isRecording ? .red : .blue)
                    }

                    Button(action: {
                        translationViewModel.clearHistory()
                    }) {
                        Image(systemName: "trash.circle.fill")
                            .font(.system(size: 35))
                            .foregroundColor(.gray)
                    }
                }
                .padding(.vertical, 8)
                .frame(maxWidth: .infinity)
                .background(Color(.systemBackground))
            }
        }
        .ignoresSafeArea(.keyboard)
        .alert("エラー", isPresented: $translationViewModel.showError) {
            Button("OK", role: .cancel) {}
        } message: {
            Text(translationViewModel.errorMessage)
        }
    }
}

// オートスクロール対応のテキスト表示コンポーネント
struct TranslationTextView: View {
    let title: String
    let text: String
    let color: Color
    let height: CGFloat

    var body: some View {
        VStack(alignment: .leading, spacing: 6) {
            Text(title)
                .font(.subheadline)
                .fontWeight(.semibold)
                .foregroundColor(color)
                .padding(.horizontal, 12)
                .padding(.top, 8)

            ScrollViewReader { proxy in
                ScrollView {
                    VStack(alignment: .leading) {
                        Text(text)
                            .font(.body)
                            .padding(12)
                            .frame(maxWidth: .infinity, alignment: .leading)
                            .id("bottom")
                    }
                }
                .frame(maxWidth: .infinity, maxHeight: .infinity)
                .background(color.opacity(0.1))
                .cornerRadius(10)
                .onChange(of: text) { oldValue, newValue in
                    // テキストが更新されたら最下部にスクロール
                    withAnimation(.easeOut(duration: 0.3)) {
                        proxy.scrollTo("bottom", anchor: .bottom)
                    }
                }
            }
            .padding(.horizontal, 8)
            .padding(.bottom, 8)
        }
        .frame(maxWidth: .infinity, maxHeight: height)
        .background(Color(.systemBackground))
        .cornerRadius(12)
        .shadow(color: color.opacity(0.2), radius: 4, x: 0, y: 2)
    }
}

