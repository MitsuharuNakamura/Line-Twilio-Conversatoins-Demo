import SwiftUI
import Security

// Keychainヘルパー
class KeychainHelper {
    static let shared = KeychainHelper()
    private let service = "com.mitsuharunakamura.RealtimeTranslation"

    private init() {}

    func save(key: String, value: String) -> Bool {
        guard let data = value.data(using: .utf8) else { return false }

        delete(key: key)

        let query: [String: Any] = [
            kSecClass as String: kSecClassGenericPassword,
            kSecAttrService as String: service,
            kSecAttrAccount as String: key,
            kSecValueData as String: data
        ]

        let status = SecItemAdd(query as CFDictionary, nil)
        return status == errSecSuccess
    }

    func get(key: String) -> String? {
        let query: [String: Any] = [
            kSecClass as String: kSecClassGenericPassword,
            kSecAttrService as String: service,
            kSecAttrAccount as String: key,
            kSecReturnData as String: true,
            kSecMatchLimit as String: kSecMatchLimitOne
        ]

        var result: AnyObject?
        let status = SecItemCopyMatching(query as CFDictionary, &result)

        guard status == errSecSuccess,
              let data = result as? Data,
              let value = String(data: data, encoding: .utf8) else {
            return nil
        }

        return value
    }

    func delete(key: String) -> Bool {
        let query: [String: Any] = [
            kSecClass as String: kSecClassGenericPassword,
            kSecAttrService as String: service,
            kSecAttrAccount as String: key
        ]

        let status = SecItemDelete(query as CFDictionary)
        return status == errSecSuccess || status == errSecItemNotFound
    }
}

// 設定画面
struct SettingsView: View {
    @Environment(\.dismiss) var dismiss
    @State private var apiKey: String = ""
    @State private var showSaveSuccess = false
    @State private var showDeleteSuccess = false

    var body: some View {
        ZStack {
            LinearGradient(
                gradient: Gradient(colors: [
                    Color(red: 0.1, green: 0.2, blue: 0.45),
                    Color(red: 0.3, green: 0.5, blue: 0.9)
                ]),
                startPoint: .topLeading,
                endPoint: .bottomTrailing
            )
            .ignoresSafeArea()

            VStack(spacing: 20) {
                HStack {
                    Button(action: { dismiss() }) {
                        Image(systemName: "xmark.circle.fill")
                            .font(.system(size: 30))
                            .foregroundColor(.white.opacity(0.8))
                    }

                    Spacer()

                    Text("設定")
                        .font(.title2)
                        .fontWeight(.bold)
                        .foregroundColor(.white)

                    Spacer()

                    Image(systemName: "xmark.circle.fill")
                        .font(.system(size: 30))
                        .foregroundColor(.clear)
                }
                .padding()

                VStack(spacing: 16) {
                    Text("OpenAI API Key")
                        .font(.headline)
                        .foregroundColor(.white)
                        .frame(maxWidth: .infinity, alignment: .leading)

                    SecureField("sk-...", text: $apiKey)
                        .textFieldStyle(.plain)
                        .padding()
                        .background(.ultraThinMaterial)
                        .cornerRadius(12)
                        .foregroundColor(.white)
                        .autocapitalization(.none)
                        .autocorrectionDisabled()

                    Text("APIキーはデバイスに安全に保存されます")
                        .font(.caption)
                        .foregroundColor(.white.opacity(0.7))
                        .frame(maxWidth: .infinity, alignment: .leading)

                    HStack(spacing: 12) {
                        Button(action: saveAPIKey) {
                            Text("保存")
                                .font(.headline)
                                .foregroundColor(.white)
                                .frame(maxWidth: .infinity)
                                .padding()
                                .background(.green.opacity(0.8))
                                .cornerRadius(12)
                        }

                        Button(action: deleteAPIKey) {
                            Text("削除")
                                .font(.headline)
                                .foregroundColor(.white)
                                .frame(maxWidth: .infinity)
                                .padding()
                                .background(.red.opacity(0.8))
                                .cornerRadius(12)
                        }
                    }

                    if showSaveSuccess {
                        Text("✓ 保存しました")
                            .font(.subheadline)
                            .foregroundColor(.green)
                            .padding(.top, 8)
                    }

                    if showDeleteSuccess {
                        Text("✓ 削除しました")
                            .font(.subheadline)
                            .foregroundColor(.red)
                            .padding(.top, 8)
                    }
                }
                .padding()
                .background(.ultraThinMaterial)
                .cornerRadius(16)
                .padding()

                Spacer()
            }
            .padding(.top, 50)
        }
        .onAppear {
            if let savedKey = KeychainHelper.shared.get(key: "OPENAI_API_KEY") {
                apiKey = savedKey
            }
        }
    }

    private func saveAPIKey() {
        guard !apiKey.isEmpty else { return }

        if KeychainHelper.shared.save(key: "OPENAI_API_KEY", value: apiKey) {
            showSaveSuccess = true
            showDeleteSuccess = false

            DispatchQueue.main.asyncAfter(deadline: .now() + 2) {
                showSaveSuccess = false
            }
        }
    }

    private func deleteAPIKey() {
        if KeychainHelper.shared.delete(key: "OPENAI_API_KEY") {
            apiKey = ""
            showDeleteSuccess = true
            showSaveSuccess = false

            DispatchQueue.main.asyncAfter(deadline: .now() + 2) {
                showDeleteSuccess = false
            }
        }
    }
}

struct ContentView: View {
    @StateObject private var translationViewModel = TranslationViewModel()
    @Environment(\.horizontalSizeClass) var horizontalSizeClass
    @Environment(\.verticalSizeClass) var verticalSizeClass
    @State private var showSettings = false

    // デバイスの向きを判定
    var isLandscape: Bool {
        horizontalSizeClass == .regular || verticalSizeClass == .compact
    }

    var body: some View {
        ZStack {
            // グラデーション背景 - 全画面に表示
            LinearGradient(
                gradient: Gradient(colors: [
                    Color(red: 0.1, green: 0.2, blue: 0.45),
                    Color(red: 0.3, green: 0.5, blue: 0.9)
                ]),
                startPoint: .topLeading,
                endPoint: .bottomTrailing
            )
            .ignoresSafeArea()

            VStack(spacing: 0) {
                // Header - Glass Design (インナーカメラの下に配置)
                HStack {
                    Spacer()

                    Text("リアルタイム音声翻訳")
                        .font(.headline)
                        .fontWeight(.semibold)
                        .foregroundColor(.white)

                    Spacer()

                    Button(action: {
                        showSettings = true
                    }) {
                        Image(systemName: "gearshape.fill")
                            .font(.system(size: 20))
                            .foregroundColor(.white.opacity(0.8))
                            .padding(.trailing, 12)
                    }
                }
                .padding(.top, 50)
                .padding(.bottom, 12)
                .frame(maxWidth: .infinity)
                .background(.ultraThinMaterial)

                // Translation Display Area
                if isLandscape {
                    // 横向き: 横並びレイアウト
                    HStack(spacing: 8) {
                        TranslationTextView(
                            title: "English",
                            text: translationViewModel.recognizedText.isEmpty ? "音声を認識中..." : translationViewModel.recognizedText,
                            color: .blue,
                            height: nil
                        )

                        TranslationTextView(
                            title: "日本語",
                            text: translationViewModel.translatedText.isEmpty ? "翻訳を待機中..." : translationViewModel.translatedText,
                            color: .green,
                            height: nil
                        )
                    }
                    .padding(.horizontal, 12)
                    .padding(.vertical, 8)
                    .frame(maxHeight: .infinity)
                } else {
                    // 縦向き: 縦並びレイアウト
                    VStack(spacing: 8) {
                        TranslationTextView(
                            title: "English",
                            text: translationViewModel.recognizedText.isEmpty ? "音声を認識中..." : translationViewModel.recognizedText,
                            color: .blue,
                            height: nil
                        )

                        TranslationTextView(
                            title: "日本語",
                            text: translationViewModel.translatedText.isEmpty ? "翻訳を待機中..." : translationViewModel.translatedText,
                            color: .green,
                            height: nil
                        )

                        // Translation History - Glass Design
                        if !translationViewModel.history.isEmpty {
                            VStack(alignment: .leading, spacing: 2) {
                                Text("履歴")
                                    .font(.caption2)
                                    .fontWeight(.semibold)
                                    .foregroundColor(.white)
                                    .padding(.horizontal, 10)
                                    .padding(.top, 4)

                                ScrollView {
                                    VStack(alignment: .leading, spacing: 2) {
                                        ForEach(translationViewModel.history) { item in
                                            VStack(alignment: .leading, spacing: 1) {
                                                Text(item.originalText)
                                                    .font(.system(size: 10))
                                                    .foregroundColor(.white.opacity(0.7))
                                                Text(item.translatedText)
                                                    .font(.caption2)
                                                    .foregroundColor(.white)
                                                Divider()
                                                    .background(Color.white.opacity(0.3))
                                            }
                                            .padding(.vertical, 1)
                                        }
                                    }
                                    .padding(.horizontal, 10)
                                }
                            }
                            .frame(height: 100)
                            .background(.ultraThinMaterial)
                            .cornerRadius(12)
                            .padding(.horizontal, 12)
                        }
                    }
                    .padding(.horizontal, 12)
                    .padding(.vertical, 8)
                    .frame(maxHeight: .infinity)
                }

                // Control Buttons - Glass Design
                HStack(spacing: 20) {
                    Button(action: {
                        if translationViewModel.isRecording {
                            translationViewModel.stopRecording()
                        } else {
                            translationViewModel.startRecording()
                        }
                    }) {
                        Image(systemName: translationViewModel.isRecording ? "stop.circle.fill" : "mic.circle.fill")
                            .font(.system(size: 50))
                            .foregroundColor(translationViewModel.isRecording ? .red : .white)
                            .shadow(color: .black.opacity(0.3), radius: 4, x: 0, y: 2)
                    }

                    Button(action: {
                        translationViewModel.clearHistory()
                    }) {
                        Image(systemName: "trash.circle.fill")
                            .font(.system(size: 35))
                            .foregroundColor(.white.opacity(0.8))
                            .shadow(color: .black.opacity(0.3), radius: 4, x: 0, y: 2)
                    }
                }
                .padding(.vertical, 12)
                .frame(maxWidth: .infinity)
                .background(.thinMaterial)
            }
        }
        .ignoresSafeArea()
        .sheet(isPresented: $showSettings) {
            SettingsView()
        }
        .alert("エラー", isPresented: $translationViewModel.showError) {
            Button("OK", role: .cancel) {}
        } message: {
            Text(translationViewModel.errorMessage)
        }
    }
}

// オートスクロール対応のテキスト表示コンポーネント - Glass Design
struct TranslationTextView: View {
    let title: String
    let text: String
    let color: Color
    let height: CGFloat?

    var body: some View {
        VStack(alignment: .leading, spacing: 4) {
            Text(title)
                .font(.subheadline)
                .fontWeight(.bold)
                .foregroundColor(.white)
                .padding(.horizontal, 12)
                .padding(.top, 8)

            ScrollViewReader { proxy in
                ScrollView {
                    VStack(alignment: .leading) {
                        Text(text)
                            .font(.body)
                            .foregroundColor(.white)
                            .padding(12)
                            .frame(maxWidth: .infinity, alignment: .leading)
                            .id("bottom")
                    }
                }
                .frame(maxWidth: .infinity, maxHeight: .infinity)
                .background(color.opacity(0.2))
                .cornerRadius(8)
                .onChange(of: text) { oldValue, newValue in
                    // テキストが更新されたら最下部にスクロール
                    withAnimation(.easeOut(duration: 0.3)) {
                        proxy.scrollTo("bottom", anchor: .bottom)
                    }
                }
            }
            .padding(.horizontal, 8)
            .padding(.bottom, 8)
        }
        .frame(maxWidth: .infinity, maxHeight: height != nil ? height : .infinity)
        .background(.ultraThinMaterial)
        .cornerRadius(16)
        .shadow(color: .black.opacity(0.2), radius: 8, x: 0, y: 4)
    }
}

