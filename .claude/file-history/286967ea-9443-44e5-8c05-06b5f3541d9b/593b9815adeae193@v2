import Foundation
import Combine

@MainActor
class TranslationViewModel: ObservableObject {
    @Published var recognizedText: String = ""
    @Published var translatedText: String = ""
    @Published var isRecording: Bool = false
    @Published var history: [TranslationItem] = []
    @Published var showError: Bool = false
    @Published var errorMessage: String = ""

    private let speechRecognizer = SpeechRecognitionService()
    private let translationService = TranslationService()
    private var cancellables = Set<AnyCancellable>()

    init() {
        setupSubscriptions()
    }

    private func setupSubscriptions() {
        // Subscribe to speech recognition updates
        speechRecognizer.recognizedTextPublisher
            .receive(on: DispatchQueue.main)
            .sink { [weak self] text in
                self?.recognizedText = text
                // Translate the text
                Task {
                    await self?.translateText(text)
                }
            }
            .store(in: &cancellables)

        // Subscribe to errors
        speechRecognizer.errorPublisher
            .receive(on: DispatchQueue.main)
            .sink { [weak self] error in
                self?.handleError(error)
            }
            .store(in: &cancellables)

        translationService.errorPublisher
            .receive(on: DispatchQueue.main)
            .sink { [weak self] error in
                self?.handleError(error)
            }
            .store(in: &cancellables)
    }

    func startRecording() {
        Task {
            do {
                try await speechRecognizer.startRecording()
                isRecording = true
            } catch {
                handleError(error)
            }
        }
    }

    func stopRecording() {
        speechRecognizer.stopRecording()
        isRecording = false

        // Add to history if we have both texts
        if !recognizedText.isEmpty && !translatedText.isEmpty {
            let item = TranslationItem(
                originalText: recognizedText,
                translatedText: translatedText,
                timestamp: Date()
            )
            history.insert(item, at: 0)
        }

        // Clear current texts
        recognizedText = ""
        translatedText = ""
    }

    func clearHistory() {
        history.removeAll()
    }

    private func translateText(_ text: String) async {
        guard !text.isEmpty else {
            translatedText = ""
            return
        }

        do {
            let translated = try await translationService.translate(text: text, from: "en", to: "ja")
            translatedText = translated
        } catch {
            handleError(error)
        }
    }

    private func handleError(_ error: Error) {
        errorMessage = error.localizedDescription
        showError = true
    }
}
