import React, { useState, useEffect } from 'react';
import {
  StyleSheet,
  Text,
  View,
  TouchableOpacity,
  ScrollView,
  SafeAreaView,
  ActivityIndicator,
  Alert,
} from 'react-native';
import { StatusBar } from 'expo-status-bar';
import { useSpeechRecognition } from './src/hooks/useSpeechRecognition';
import { initializeOpenAI, translateTextStreaming } from './src/services/translationService';
import { OPENAI_API_KEY } from '@env';

export default function App() {
  const [translatedText, setTranslatedText] = useState('');
  const [isTranslating, setIsTranslating] = useState(false);
  const [translationHistory, setTranslationHistory] = useState([]);

  const {
    isListening,
    recognizedText,
    partialText,
    error,
    startListening,
    stopListening,
  } = useSpeechRecognition();

  // OpenAI初期化
  useEffect(() => {
    if (OPENAI_API_KEY) {
      initializeOpenAI(OPENAI_API_KEY);
    } else {
      Alert.alert('エラー', '.envファイルにOPENAI_API_KEYを設定してください');
    }
  }, []);

  // 音声認識結果が更新されたら自動翻訳
  useEffect(() => {
    if (recognizedText && recognizedText.trim().length > 0) {
      handleTranslate(recognizedText);
    }
  }, [recognizedText]);

  const handleTranslate = async (text) => {
    setIsTranslating(true);
    setTranslatedText('');

    try {
      await translateTextStreaming(text, (partialTranslation) => {
        // ストリーミングで翻訳結果を逐次表示
        setTranslatedText(partialTranslation);
      });

      // 翻訳完了後、履歴に追加
      setTranslationHistory((prev) => [
        { english: text, japanese: translatedText },
        ...prev.slice(0, 9), // 最新10件まで保持
      ]);
    } catch (err) {
      Alert.alert('翻訳エラー', err.message);
    } finally {
      setIsTranslating(false);
    }
  };

  const handleMicPress = () => {
    if (isListening) {
      stopListening();
    } else {
      startListening();
    }
  };

  const displayText = partialText || recognizedText || '音声を認識中...';

  return (
    <SafeAreaView style={styles.container}>
      <StatusBar style="dark" />

      {/* ヘッダー */}
      <View style={styles.header}>
        <Text style={styles.headerTitle}>リアルタイム翻訳</Text>
        <Text style={styles.headerSubtitle}>English → 日本語</Text>
      </View>

      {/* メインコンテンツ */}
      <View style={styles.mainContent}>
        {/* 英語表示エリア */}
        <View style={styles.textBox}>
          <Text style={styles.label}>🇺🇸 English</Text>
          <ScrollView style={styles.textScrollView}>
            <Text style={[styles.text, partialText && styles.partialText]}>
              {isListening ? displayText : recognizedText || '音声認識待機中...'}
            </Text>
          </ScrollView>
        </View>

        {/* 翻訳表示エリア */}
        <View style={styles.textBox}>
          <Text style={styles.label}>🇯🇵 日本語</Text>
          <ScrollView style={styles.textScrollView}>
            {isTranslating ? (
              <View style={styles.loadingContainer}>
                <ActivityIndicator size="large" color="#007AFF" />
                <Text style={styles.loadingText}>翻訳中...</Text>
              </View>
            ) : (
              <Text style={styles.text}>{translatedText || '翻訳待機中...'}</Text>
            )}
          </ScrollView>
        </View>
      </View>

      {/* コントロールボタン */}
      <View style={styles.controls}>
        <TouchableOpacity
          style={[styles.micButton, isListening && styles.micButtonActive]}
          onPress={handleMicPress}
        >
          <Text style={styles.micButtonText}>{isListening ? '⏸ 停止' : '🎤 開始'}</Text>
        </TouchableOpacity>

        {error && <Text style={styles.errorText}>エラー: {error}</Text>}
      </View>

      {/* 翻訳履歴 */}
      {translationHistory.length > 0 && (
        <View style={styles.historyContainer}>
          <Text style={styles.historyTitle}>履歴</Text>
          <ScrollView style={styles.historyScroll}>
            {translationHistory.map((item, index) => (
              <View key={index} style={styles.historyItem}>
                <Text style={styles.historyEnglish}>{item.english}</Text>
                <Text style={styles.historyJapanese}>→ {item.japanese}</Text>
              </View>
            ))}
          </ScrollView>
        </View>
      )}
    </SafeAreaView>
  );
}

