import Foundation
import AVFoundation
import Combine

class VideoManager: ObservableObject {
    @Published var videos: [Video] = []

    init() {
        loadVideos()
    }

    func loadVideos() {
        // デバッグ: Bundle内のリソースパスを確認
        print("Bundle path: \(Bundle.main.bundlePath)")
        print("Resource path: \(Bundle.main.resourcePath ?? "nil")")

        // Bundle内のすべてのリソースを表示
        if let resourcePath = Bundle.main.resourcePath {
            do {
                let contents = try FileManager.default.contentsOfDirectory(atPath: resourcePath)
                print("Bundle contents: \(contents)")
            } catch {
                print("Error listing bundle contents: \(error)")
            }
        }

        guard let videosURL = Bundle.main.url(forResource: "videos", withExtension: nil) else {
            print("Videos directory not found")
            print("Trying alternative method...")

            // 代替方法: Bundle内のvideoディレクトリを直接探す
            if let resourcePath = Bundle.main.resourcePath {
                let videosPath = (resourcePath as NSString).appendingPathComponent("videos")
                print("Checking path: \(videosPath)")
                if FileManager.default.fileExists(atPath: videosPath) {
                    print("Found videos at: \(videosPath)")
                    loadVideosFromPath(URL(fileURLWithPath: videosPath))
                    return
                }
            }
            return
        }

        loadVideosFromPath(videosURL)
    }

    private func loadVideosFromPath(_ videosURL: URL) {
        do {
            let fileURLs = try FileManager.default.contentsOfDirectory(
                at: videosURL,
                includingPropertiesForKeys: nil,
                options: [.skipsHiddenFiles]
            )

            print("Found \(fileURLs.count) files in videos directory")

            let videoExtensions = ["mp4", "mov", "m4v", "avi"]
            let videoFiles = fileURLs.filter { url in
                videoExtensions.contains(url.pathExtension.lowercased())
            }

            print("Found \(videoFiles.count) video files")

            videos = videoFiles.map { url in
                let filename = url.lastPathComponent
                let title = url.deletingPathExtension().lastPathComponent
                    .replacingOccurrences(of: "_", with: " ")
                    .replacingOccurrences(of: "-", with: " ")
                print("Added video: \(title)")
                return Video(filename: filename, title: title)
            }.sorted { $0.title < $1.title }

        } catch {
            print("Error loading videos: \(error)")
        }
    }

    func getVideoURL(for video: Video) -> URL? {
        return Bundle.main.url(forResource: "videos/\(video.filename.replacingOccurrences(of: ".\(video.filename.split(separator: ".").last ?? "")", with: ""))", withExtension: String(video.filename.split(separator: ".").last ?? ""))
    }
}
