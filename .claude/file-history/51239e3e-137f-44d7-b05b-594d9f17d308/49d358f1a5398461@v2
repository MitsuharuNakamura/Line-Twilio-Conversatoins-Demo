import SwiftUI
import AVKit

struct VideoPlayerView: View {
    let video: Video
    @Binding var isPresented: Bool
    @State private var player: AVPlayer?

    private var isIPad: Bool {
        UIDevice.current.userInterfaceIdiom == .pad
    }

    private var closeButtonSize: CGFloat {
        isIPad ? 44 : 30
    }

    private var closeButtonPadding: CGFloat {
        isIPad ? 30 : 20
    }

    var body: some View {
        ZStack {
            Color.black.ignoresSafeArea()

            if let player = player {
                VideoPlayer(player: player)
                    .ignoresSafeArea()
                    .onAppear {
                        player.play()
                    }
                    .onDisappear {
                        player.pause()
                    }
            } else {
                VStack(spacing: isIPad ? 30 : 20) {
                    ProgressView()
                        .progressViewStyle(CircularProgressViewStyle(tint: .white))
                        .scaleEffect(isIPad ? 2.0 : 1.5)

                    Text("動画を読み込んでいます...")
                        .foregroundColor(.white)
                        .font(isIPad ? .title3 : .subheadline)
                }
            }

            // 閉じるボタン
            VStack {
                HStack {
                    Button(action: {
                        isPresented = false
                    }) {
                        Image(systemName: "xmark.circle.fill")
                            .font(.system(size: closeButtonSize))
                            .foregroundColor(.white)
                            .shadow(color: .black.opacity(0.5), radius: isIPad ? 6 : 4, x: 0, y: isIPad ? 3 : 2)
                    }
                    .padding(closeButtonPadding)

                    Spacer()
                }
                Spacer()
            }
        }
        .onAppear {
            setupPlayer()
        }
        .onDisappear {
            player?.pause()
            player = nil
        }
    }

    private func setupPlayer() {
        let components = video.filename.components(separatedBy: ".")
        let nameWithoutExtension = components.dropLast().joined(separator: ".")
        let ext = components.last ?? ""

        var videoURL: URL?

        // まず、videosフォルダ内を探す
        videoURL = Bundle.main.url(forResource: "videos/\(nameWithoutExtension)", withExtension: ext)

        // Bundleルート直下を探す
        if videoURL == nil {
            videoURL = Bundle.main.url(forResource: nameWithoutExtension, withExtension: ext)
        }

        guard let videoURL = videoURL else {
            print("Video file not found: \(video.filename)")
            return
        }

        print("Loading video from: \(videoURL.path)")
        player = AVPlayer(url: videoURL)

        // 動画が終了したら最初に戻る
        NotificationCenter.default.addObserver(
            forName: .AVPlayerItemDidPlayToEndTime,
            object: player?.currentItem,
            queue: .main
        ) { _ in
            player?.seek(to: .zero)
            player?.play()
        }
    }
}

