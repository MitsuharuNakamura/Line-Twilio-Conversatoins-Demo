import SwiftUI
import AVKit

struct VideoListView: View {
    @ObservedObject var videoManager: VideoManager
    @State private var selectedVideo: Video?
    @State private var showPlayer = false
    @Environment(\.horizontalSizeClass) var horizontalSizeClass
    @Environment(\.verticalSizeClass) var verticalSizeClass

    // デバイスとオリエンテーションに応じたカラム数
    private var columns: [GridItem] {
        let columnCount: Int
        let spacing: CGFloat

        if UIDevice.current.userInterfaceIdiom == .pad {
            // iPad
            if horizontalSizeClass == .regular && verticalSizeClass == .compact {
                // iPad 横向き
                columnCount = 4
                spacing = 24
            } else {
                // iPad 縦向き
                columnCount = 3
                spacing = 20
            }
        } else {
            // iPhone
            columnCount = 2
            spacing = 16
        }

        return Array(repeating: GridItem(.flexible(), spacing: spacing), count: columnCount)
    }

    // デバイスに応じたパディング
    private var horizontalPadding: CGFloat {
        UIDevice.current.userInterfaceIdiom == .pad ? 40 : 20
    }

    // デバイスに応じたサムネイルの高さ
    private var thumbnailHeight: CGFloat {
        UIDevice.current.userInterfaceIdiom == .pad ? 200 : 100
    }

    var body: some View {
        let _ = print("VideoListView: rendering with \(videoManager.videos.count) videos")
        let _ = print("VideoListView: isEmpty = \(videoManager.videos.isEmpty)")

        return NavigationView {
            ZStack {
                // Netflix風のダークな背景
                Color.black.ignoresSafeArea()

                if videoManager.videos.isEmpty {
                    VStack(spacing: 20) {
                        Image(systemName: "film.stack")
                            .font(.system(size: UIDevice.current.userInterfaceIdiom == .pad ? 80 : 60))
                            .foregroundColor(.gray)
                        Text("動画がありません")
                            .font(UIDevice.current.userInterfaceIdiom == .pad ? .title : .title2)
                            .foregroundColor(.white)
                        Text("videosフォルダに動画を追加してください")
                            .font(UIDevice.current.userInterfaceIdiom == .pad ? .body : .caption)
                            .foregroundColor(.gray)
                    }
                } else {
                    ScrollView {
                        VStack(alignment: .leading, spacing: UIDevice.current.userInterfaceIdiom == .pad ? 30 : 20) {
                            // ヘッダー
                            VStack(alignment: .leading, spacing: 12) {
                                Text("マイビデオ")
                                    .font(UIDevice.current.userInterfaceIdiom == .pad ? .system(size: 48, weight: .bold) : .largeTitle)
                                    .fontWeight(.bold)
                                    .foregroundColor(.white)

                                Text("\(videoManager.videos.count)本の動画")
                                    .font(UIDevice.current.userInterfaceIdiom == .pad ? .title3 : .subheadline)
                                    .foregroundColor(.gray)
                            }
                            .padding(.horizontal, horizontalPadding)
                            .padding(.top, UIDevice.current.userInterfaceIdiom == .pad ? 40 : 20)

                            // グリッドビュー
                            LazyVGrid(columns: columns, spacing: UIDevice.current.userInterfaceIdiom == .pad ? 20 : 16) {
                                ForEach(videoManager.videos) { video in
                                    VideoThumbnailCard(video: video, thumbnailHeight: thumbnailHeight)
                                        .onTapGesture {
                                            selectedVideo = video
                                            showPlayer = true
                                        }
                                }
                            }
                            .padding(.horizontal, horizontalPadding)
                        }
                        .padding(.bottom, UIDevice.current.userInterfaceIdiom == .pad ? 40 : 20)
                    }
                }
            }
            .navigationBarHidden(true)
        }
        .fullScreenCover(isPresented: $showPlayer) {
            if let video = selectedVideo {
                VideoPlayerView(video: video, isPresented: $showPlayer)
            }
        }
    }
}

struct VideoThumbnailCard: View {
    let video: Video
    let thumbnailHeight: CGFloat
    @State private var thumbnail: UIImage?

    private var isIPad: Bool {
        UIDevice.current.userInterfaceIdiom == .pad
    }

    private var cornerRadius: CGFloat {
        isIPad ? 12 : 8
    }

    private var playIconSize: CGFloat {
        isIPad ? 60 : 40
    }

    var body: some View {
        VStack(alignment: .leading, spacing: isIPad ? 12 : 8) {
            // サムネイル
            ZStack {
                if let thumbnail = thumbnail {
                    Image(uiImage: thumbnail)
                        .resizable()
                        .aspectRatio(16/9, contentMode: .fill)
                        .frame(height: thumbnailHeight)
                        .clipped()
                        .cornerRadius(cornerRadius)
                } else {
                    Rectangle()
                        .fill(
                            LinearGradient(
                                gradient: Gradient(colors: [
                                    Color(red: 0.2, green: 0.2, blue: 0.3),
                                    Color(red: 0.1, green: 0.1, blue: 0.2)
                                ]),
                                startPoint: .topLeading,
                                endPoint: .bottomTrailing
                            )
                        )
                        .frame(height: thumbnailHeight)
                        .cornerRadius(cornerRadius)
                        .overlay(
                            Image(systemName: "play.circle.fill")
                                .font(.system(size: playIconSize))
                                .foregroundColor(.white.opacity(0.7))
                        )
                }
            }
            .overlay(
                RoundedRectangle(cornerRadius: cornerRadius)
                    .stroke(Color.white.opacity(0.1), lineWidth: isIPad ? 1.5 : 1)
            )
            .shadow(color: .black.opacity(0.3), radius: isIPad ? 12 : 8, x: 0, y: isIPad ? 6 : 4)

            // タイトル
            Text(video.displayTitle)
                .font(isIPad ? .body : .subheadline)
                .fontWeight(.medium)
                .foregroundColor(.white)
                .lineLimit(2)
                .frame(maxWidth: .infinity, alignment: .leading)
        }
        .onAppear {
            generateThumbnail()
        }
    }

    private func generateThumbnail() {
        let components = video.filename.components(separatedBy: ".")
        let nameWithoutExtension = components.dropLast().joined(separator: ".")
        let ext = components.last ?? ""

        var videoURL: URL?

        // まず、videosフォルダ内を探す
        videoURL = Bundle.main.url(forResource: "videos/\(nameWithoutExtension)", withExtension: ext)

        // Bundleルート直下を探す
        if videoURL == nil {
            videoURL = Bundle.main.url(forResource: nameWithoutExtension, withExtension: ext)
        }

        guard let videoURL = videoURL else {
            print("Video file not found for thumbnail: \(video.filename)")
            return
        }

        let asset = AVAsset(url: videoURL)
        let imageGenerator = AVAssetImageGenerator(asset: asset)
        imageGenerator.appliesPreferredTrackTransform = true

        let time = CMTime(seconds: 1, preferredTimescale: 60)

        DispatchQueue.global(qos: .userInitiated).async {
            do {
                let cgImage = try imageGenerator.copyCGImage(at: time, actualTime: nil)
                let uiImage = UIImage(cgImage: cgImage)
                DispatchQueue.main.async {
                    self.thumbnail = uiImage
                }
            } catch {
                print("Error generating thumbnail: \(error)")
            }
        }
    }
}

