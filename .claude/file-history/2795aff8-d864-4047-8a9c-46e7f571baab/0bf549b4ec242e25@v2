# Twilio Account Configuration
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here

# Twilio API Key (create at https://www.twilio.com/console/voice/settings/api-keys)
TWILIO_API_KEY_SID=your_api_key_sid_here
TWILIO_API_KEY_SECRET=your_api_key_secret_here

# TwiML Application SID (create at https://www.twilio.com/console/voice/twiml/apps)
TWILIO_TWIML_APP_SID=your_twiml_app_sid_here

# Push Credential SID (create at https://www.twilio.com/console/voice/credentials)
TWILIO_PUSH_CREDENTIAL_SID=your_push_credential_sid_here

# Your Twilio phone number
TWILIO_PHONE_NUMBER=+1234567890

# Default client identity for incoming calls
DEFAULT_CLIENT_IDENTITY=default_user

# Server configuration
PORT=3000
