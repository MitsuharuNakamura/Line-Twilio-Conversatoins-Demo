#!/bin/bash

# Twilio Phone Client Setup Script
# このスクリプトは開発チームIDを設定し、Xcodeプロジェクトを生成します

echo "🚀 Twilio Phone Client セットアップ"
echo ""

# Development Team IDの入力
echo "📝 Apple Developer Team IDを入力してください"
echo "   (Xcode > Settings > Accounts > チームを選択 > Team ID をコピー)"
echo "   スキップする場合は Enter を押してください"
read -p "Team ID: " TEAM_ID

if [ -z "$TEAM_ID" ]; then
    echo "⚠️  Team IDが設定されていません。後でXcodeで手動設定する必要があります。"
    TEAM_ID=""
else
    echo "✅ Team ID: $TEAM_ID"
fi

# project.ymlを更新
echo ""
echo "⚙️  project.ymlを更新中..."
sed -i '' "s/DEVELOPMENT_TEAM: \"\"/DEVELOPMENT_TEAM: \"$TEAM_ID\"/" project.yml

# Bundle Identifierの確認
echo ""
echo "📦 Bundle Identifierの設定"
echo "   現在: com.yourcompany.twiliophonemclient"
read -p "   変更する場合は新しいIDを入力 (スキップはEnter): " BUNDLE_ID

if [ ! -z "$BUNDLE_ID" ]; then
    echo "✅ Bundle ID: $BUNDLE_ID"
    sed -i '' "s/com.yourcompany.twiliophonemclient/$BUNDLE_ID/g" project.yml
    sed -i '' "s/group.com.yourcompany.twiliophonemclient/group.$BUNDLE_ID/g" project.yml
    sed -i '' "s/group.com.yourcompany.twiliophonemclient/group.$BUNDLE_ID/g" TwilioPhoneClient.entitlements
fi

# Xcodeプロジェクトを生成
echo ""
echo "🔨 Xcodeプロジェクトを生成中..."
xcodegen generate

if [ $? -eq 0 ]; then
    echo ""
    echo "✅ セットアップ完了！"
    echo ""
    echo "📱 次のステップ:"
    echo "   1. Xcodeでプロジェクトを開く:"
    echo "      open TwilioPhoneClient.xcodeproj"
    echo ""
    echo "   2. バックエンドサーバーを起動:"
    echo "      cd ../Backend"
    echo "      npm install"
    echo "      cp .env.example .env"
    echo "      # .envを編集してTwilio認証情報を設定"
    echo "      npm start"
    echo ""
    echo "   3. iOSアプリをビルド & 実行"
    echo "      （実機を接続してXcodeで実行）"
else
    echo ""
    echo "❌ エラー: プロジェクト生成に失敗しました"
    exit 1
fi
