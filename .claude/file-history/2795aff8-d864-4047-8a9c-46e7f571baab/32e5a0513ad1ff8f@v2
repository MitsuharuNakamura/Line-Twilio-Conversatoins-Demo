const express = require('express');
const bodyParser = require('body-parser');
const cors = require('cors');
const twilio = require('twilio');
require('dotenv').config();

const app = express();
const port = process.env.PORT || 3000;

// Middleware
app.use(cors());
app.use(bodyParser.json());
app.use(bodyParser.urlencoded({ extended: true }));

// Twilio configuration
const accountSid = process.env.TWILIO_ACCOUNT_SID;
const authToken = process.env.TWILIO_AUTH_TOKEN;
const apiKeySid = process.env.TWILIO_API_KEY_SID;
const apiKeySecret = process.env.TWILIO_API_KEY_SECRET;
const twimlAppSid = process.env.TWILIO_TWIML_APP_SID;
const pushCredentialSid = process.env.TWILIO_PUSH_CREDENTIAL_SID;
const twilioPhoneNumber = process.env.TWILIO_PHONE_NUMBER;

const client = twilio(accountSid, authToken);
const { jwt } = twilio;
const AccessToken = jwt.AccessToken;
const VoiceGrant = AccessToken.VoiceGrant;

// Helper function to create access token
function createAccessToken(identity, type = 'voice') {
    const token = new AccessToken(
        accountSid,
        apiKeySid,
        apiKeySecret,
        { identity: identity }
    );

    if (type === 'voice') {
        const voiceGrant = new VoiceGrant({
            outgoingApplicationSid: twimlAppSid,
            incomingAllow: true,
            pushCredentialSid: pushCredentialSid
        });
        token.addGrant(voiceGrant);
    } else if (type === 'sip') {
        // SIP specific grants can be added here
        const voiceGrant = new VoiceGrant({
            outgoingApplicationSid: twimlAppSid,
            incomingAllow: true
        });
        token.addGrant(voiceGrant);
    }

    return token.toJwt();
}

// Routes

// Health check
app.get('/', (req, res) => {
    res.json({
        status: 'running',
        service: 'Twilio Phone Backend',
        version: '1.0.0'
    });
});

// Get Voice SDK Access Token
app.post('/token/voice', (req, res) => {
    try {
        const identity = req.body.identity || `user_${Date.now()}`;
        const token = createAccessToken(identity, 'voice');

        res.json({
            token: token,
            identity: identity
        });
    } catch (error) {
        console.error('Error generating voice token:', error);
        res.status(500).json({ error: error.message });
    }
});

// Get SIP Access Token
app.post('/token/sip', (req, res) => {
    try {
        const identity = req.body.identity || `sip_user_${Date.now()}`;
        const token = createAccessToken(identity, 'sip');

        res.json({
            token: token,
            identity: identity
        });
    } catch (error) {
        console.error('Error generating SIP token:', error);
        res.status(500).json({ error: error.message });
    }
});

// TwiML for outgoing calls
app.post('/twiml/outgoing', (req, res) => {
    const toNumber = req.body.To;
    const fromNumber = twilioPhoneNumber;

    console.log(`Outgoing call to: ${toNumber}`);

    const twiml = new twilio.twiml.VoiceResponse();

    if (!toNumber) {
        twiml.say({ language: 'ja-JP' }, '電話番号が指定されていません');
    } else {
        const dial = twiml.dial({
            callerId: fromNumber,
            answerOnBridge: true,
            record: 'record-from-answer-dual'
        });
        dial.number(toNumber);
    }

    res.type('text/xml');
    res.send(twiml.toString());
});

// TwiML for incoming calls
app.post('/twiml/incoming', (req, res) => {
    const from = req.body.From;
    console.log(`Incoming call from: ${from}`);

    const twiml = new twilio.twiml.VoiceResponse();
    twiml.say({ language: 'ja-JP' }, 'Twilioへようこそ。接続しています。');

    const dial = twiml.dial({
        answerOnBridge: true,
        record: 'record-from-answer-dual'
    });

    // Route to the client (mobile app)
    const identity = process.env.DEFAULT_CLIENT_IDENTITY || 'default_user';
    dial.client(identity);

    res.type('text/xml');
    res.send(twiml.toString());
});

// Get list of phone numbers
app.get('/phone-numbers', async (req, res) => {
    try {
        const incomingPhoneNumbers = await client.incomingPhoneNumbers.list({
            limit: 20
        });

        const numbers = incomingPhoneNumbers.map(record => ({
            phoneNumber: record.phoneNumber,
            friendlyName: record.friendlyName,
            sid: record.sid,
            capabilities: record.capabilities
        }));

        res.json({ numbers });
    } catch (error) {
        console.error('Error fetching phone numbers:', error);
        res.status(500).json({ error: error.message });
    }
});

// Make outgoing call (server-initiated)
app.post('/call/outgoing', async (req, res) => {
    try {
        const { to, from } = req.body;
        const fromNumber = from || twilioPhoneNumber;

        const call = await client.calls.create({
            url: `${req.protocol}://${req.get('host')}/twiml/outgoing`,
            to: to,
            from: fromNumber
        });

        res.json({
            callSid: call.sid,
            status: call.status
        });
    } catch (error) {
        console.error('Error making outbound call:', error);
        res.status(500).json({ error: error.message });
    }
});

// Get call status
app.get('/call/:callSid', async (req, res) => {
    try {
        const call = await client.calls(req.params.callSid).fetch();

        res.json({
            sid: call.sid,
            status: call.status,
            direction: call.direction,
            from: call.from,
            to: call.to,
            duration: call.duration,
            startTime: call.startTime,
            endTime: call.endTime
        });
    } catch (error) {
        console.error('Error fetching call status:', error);
        res.status(500).json({ error: error.message });
    }
});

// WebRTC signaling endpoint (for P2P calls)
app.post('/webrtc/signal', (req, res) => {
    // This would integrate with a signaling server for WebRTC
    // For now, returning a placeholder
    res.json({
        message: 'WebRTC signaling endpoint - to be implemented'
    });
});

// Error handling middleware
app.use((err, req, res, next) => {
    console.error('Unhandled error:', err);
    res.status(500).json({
        error: 'Internal server error',
        message: err.message
    });
});

// Start server
app.listen(port, () => {
    console.log(`🚀 Twilio Phone Backend running on port ${port}`);
    console.log(`📱 Voice token endpoint: http://localhost:${port}/token/voice`);
    console.log(`📞 SIP token endpoint: http://localhost:${port}/token/sip`);
    console.log(`📋 TwiML outgoing: http://localhost:${port}/twiml/outgoing`);
    console.log(`📲 TwiML incoming: http://localhost:${port}/twiml/incoming`);

    // Validate configuration
    if (!accountSid || !authToken) {
        console.warn('⚠️  Warning: TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN must be set');
    }
    if (!apiKeySid || !apiKeySecret) {
        console.warn('⚠️  Warning: TWILIO_API_KEY_SID and TWILIO_API_KEY_SECRET must be set');
    }
    if (!twimlAppSid) {
        console.warn('⚠️  Warning: TWILIO_TWIML_APP_SID must be set');
    }
});

module.exports = app;
