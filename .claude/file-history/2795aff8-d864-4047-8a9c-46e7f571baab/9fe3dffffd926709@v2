#!/bin/bash

# Apple Developer Team IDを取得するスクリプト

echo "🔍 Apple Developer Team ID 取得方法"
echo ""
echo "方法1: Xcode から取得"
echo "  1. Xcode を開く"
echo "  2. Xcode > Settings (⌘,)"
echo "  3. Accounts タブを選択"
echo "  4. Apple IDでサインイン"
echo "  5. チームを選択して Team ID をコピー"
echo ""
echo "方法2: コマンドラインから取得"
echo ""

# security コマンドで証明書から取得を試みる
if command -v security &> /dev/null; then
    echo "📋 利用可能なDevelopment Teamを検索中..."
    echo ""

    # キーチェーンから開発証明書を検索
    security find-identity -v -p codesigning | grep "Developer" | while read line; do
        echo "  $line"
    done

    echo ""
    echo "💡 ヒント: 括弧内の10文字のIDがTeam IDです"
    echo "   例: (ABCDE12345) → Team ID = ABCDE12345"
else
    echo "❌ security コマンドが見つかりません"
fi

echo ""
echo "方法3: Apple Developer ポータル"
echo "  https://developer.apple.com/account"
echo "  → Membership → Team ID"
echo ""
