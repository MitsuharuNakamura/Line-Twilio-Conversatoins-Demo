import Foundation

struct TwilioConfig {
    // Backend server configuration
    static let baseURL = ProcessInfo.processInfo.environment["TWILIO_SERVER_URL"] ?? "http://localhost:3000"

    // Twilio configuration
    static let accountSid = ProcessInfo.processInfo.environment["TWILIO_ACCOUNT_SID"] ?? ""
    static let authToken = ProcessInfo.processInfo.environment["TWILIO_AUTH_TOKEN"] ?? ""
    static let apiKeySid = ProcessInfo.processInfo.environment["TWILIO_API_KEY_SID"] ?? ""
    static let apiKeySecret = ProcessInfo.processInfo.environment["TWILIO_API_KEY_SECRET"] ?? ""
    static let twimlAppSid = ProcessInfo.processInfo.environment["TWILIO_TWIML_APP_SID"] ?? ""
    static let pushCredentialSid = ProcessInfo.processInfo.environment["TWILIO_PUSH_CREDENTIAL_SID"] ?? ""

    // User identity
    static var userIdentity: String {
        if let identity = UserDefaults.standard.string(forKey: "userIdentity") {
            return identity
        }

        let newIdentity = UIDevice.current.identifierForVendor?.uuidString ?? UUID().uuidString
        UserDefaults.standard.set(newIdentity, forKey: "userIdentity")
        return newIdentity
    }

    // Validation
    static var isConfigured: Bool {
        return !accountSid.isEmpty &&
               !authToken.isEmpty &&
               !apiKeySid.isEmpty &&
               !apiKeySecret.isEmpty &&
               !twimlAppSid.isEmpty
    }
}
