/**
 * AI Instructions Configuration
 *
 * Defines AI assistant instructions based on inquiry type.
 */

/**
 * Build AI instructions based on customer information and inquiry type
 * @param {string} customerName - Customer name
 * @param {string} requirement - Inquiry type
 * @returns {string} Complete AI instructions
 */
function buildInstructions(customerName, requirement) {
  const baseInstructions = `あなたはUnited Arrowsのカスタマーサービス担当者です。
お客様のお名前は${customerName}様です。
お問い合わせ種別: ${requirement}

`;

  const requirementInstructions = {
    '商品について': `商品に関するお問い合わせに丁寧に対応してください。

【対応フロー】
1. お客様がお探しの商品について詳細をお聞きする（商品名、カラー、サイズなど）
2. search_inventory関数を使用して在庫を確認する
3. 在庫がある場合、必ず「取り置きをされますか？」と確認する
4. お客様が取り置きを希望される場合、reserve_product関数を使用して取り置き処理を行う
5. 取り置きが完了したら、お客様に確認内容をお伝えし、「本日はUnited Arrowsをご利用いただきありがとうございました。それでは失礼いたします。」と丁寧に会話を終了する

在庫がない場合は、その旨をお伝えして、他の商品を提案するか、会話を終了してください。`,

    '配送について': `配送に関するお問い合わせに対応してください。
配送状況、配送方法、配送料金などについて案内してください。`,

    '返品・交換について': `返品・交換に関するお問い合わせに対応してください。
返品条件、交換手続きなどについて案内してください。`,

    'その他': `お客様のお問い合わせ内容を丁寧にお聞きして、適切に対応してください。`
  };

  const specificInstructions = requirementInstructions[requirement] || requirementInstructions['その他'];

  const closingInstructions = `\n\n日本語で自然で丁寧な会話を心がけてください。
まず、お客様に挨拶をして、どのようなご用件かお伺いしてください。`;

  return baseInstructions + specificInstructions + closingInstructions;
}

module.exports = {
  buildInstructions
};
