* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', 'Noto Sans JP', sans-serif;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  min-height: 100vh;
  padding: 20px;
  color: #333;
}

.container {
  max-width: 1200px;
  margin: 0 auto;
}

header {
  text-align: center;
  color: white;
  margin-bottom: 40px;
  padding: 20px;
}

header h1 {
  font-size: 3em;
  font-weight: 300;
  letter-spacing: 2px;
  margin-bottom: 10px;
  text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
}

.subtitle {
  font-size: 1.2em;
  opacity: 0.9;
}

main {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30px;
  margin-bottom: 40px;
}

@media (max-width: 768px) {
  main {
    grid-template-columns: 1fr;
  }
}

.form-container,
.info-panel {
  background: white;
  border-radius: 12px;
  padding: 30px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
}

h2, h3 {
  color: #667eea;
  margin-bottom: 20px;
  font-weight: 600;
}

.form-group {
  margin-bottom: 20px;
}

label {
  display: block;
  margin-bottom: 8px;
  font-weight: 500;
  color: #555;
}

input,
select {
  width: 100%;
  padding: 12px 15px;
  border: 2px solid #e0e0e0;
  border-radius: 8px;
  font-size: 16px;
  transition: all 0.3s ease;
  font-family: inherit;
}

input:focus,
select:focus {
  outline: none;
  border-color: #667eea;
  box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
}

.call-button {
  width: 100%;
  padding: 16px 30px;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  border-radius: 8px;
  font-size: 18px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  margin-top: 30px;
}

.call-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(102, 126, 234, 0.4);
}

.call-button:active {
  transform: translateY(0);
}

.call-button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  transform: none;
}

.call-button .icon {
  font-size: 24px;
}

.status {
  margin-top: 20px;
  padding: 15px;
  border-radius: 8px;
  text-align: center;
  font-weight: 500;
  display: none;
}

.status.active {
  display: block;
}

.status.info {
  background-color: #e3f2fd;
  color: #1976d2;
  border: 1px solid #90caf9;
}

.status.success {
  background-color: #e8f5e9;
  color: #388e3c;
  border: 1px solid #81c784;
}

.status.error {
  background-color: #ffebee;
  color: #d32f2f;
  border: 1px solid #ef5350;
}

.info-panel ol {
  margin-left: 20px;
  margin-bottom: 30px;
}

.info-panel li {
  margin-bottom: 12px;
  line-height: 1.6;
  color: #555;
}

.note {
  background-color: #fff3e0;
  border-left: 4px solid #ff9800;
  padding: 20px;
  border-radius: 8px;
  margin-top: 20px;
}

.note strong {
  color: #e65100;
  display: block;
  margin-bottom: 10px;
}

.note ul {
  margin-left: 20px;
}

.note li {
  margin-bottom: 8px;
  color: #555;
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.5;
  }
}

.calling {
  animation: pulse 1.5s ease-in-out infinite;
}
