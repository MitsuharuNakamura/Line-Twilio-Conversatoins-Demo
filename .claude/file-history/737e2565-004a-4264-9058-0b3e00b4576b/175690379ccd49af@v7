require('dotenv').config();
const express = require('express');
const WebSocket = require('ws');
const twilio = require('twilio');
const fs = require('fs');
const path = require('path');

const app = express();
const PORT = process.env.PORT || 3000;

// Check required environment variables at startup
const requiredEnvVars = [
  'TWILIO_ACCOUNT_SID',
  'TWILIO_API_KEY',
  'TWILIO_API_SECRET',
  'TWILIO_TWIML_APP_SID',
  'OPENAI_API_KEY'
];

const missingEnvVars = requiredEnvVars.filter(varName => !process.env[varName]);

if (missingEnvVars.length > 0) {
  console.error('\n❌ ERROR: Missing required environment variables:');
  missingEnvVars.forEach(varName => console.error(`   - ${varName}`));
  console.error('\nPlease create a .env file based on .env.example and fill in all required values.\n');
  process.exit(1);
}

// Load inventory data
const inventoryData = JSON.parse(
  fs.readFileSync(path.join(__dirname, 'data', 'inventory.json'), 'utf8')
);

app.use(express.json());
app.use(express.urlencoded({ extended: true }));
app.use(express.static('public'));

// Generate Twilio Access Token for Voice SDK
app.post('/api/token', (req, res) => {
  try {
    // Check required environment variables
    const requiredEnvVars = [
      'TWILIO_ACCOUNT_SID',
      'TWILIO_API_KEY',
      'TWILIO_API_SECRET',
      'TWILIO_TWIML_APP_SID'
    ];

    const missingVars = requiredEnvVars.filter(varName => !process.env[varName]);

    if (missingVars.length > 0) {
      console.error('Missing environment variables:', missingVars);
      return res.status(500).json({
        error: 'Server configuration error',
        message: `Missing required environment variables: ${missingVars.join(', ')}`,
        details: 'Please check your .env file'
      });
    }

    const { identity } = req.body;
    console.log('Generating token for identity:', identity || 'user');

    const AccessToken = twilio.jwt.AccessToken;
    const VoiceGrant = AccessToken.VoiceGrant;

    const token = new AccessToken(
      process.env.TWILIO_ACCOUNT_SID,
      process.env.TWILIO_API_KEY,
      process.env.TWILIO_API_SECRET,
      { identity: identity || 'user' }
    );

    const voiceGrant = new VoiceGrant({
      outgoingApplicationSid: process.env.TWILIO_TWIML_APP_SID,
      incomingAllow: true
    });

    token.addGrant(voiceGrant);

    console.log('Token generated successfully');
    res.json({
      token: token.toJwt(),
      identity: identity || 'user'
    });
  } catch (error) {
    console.error('Error generating token:', error);
    res.status(500).json({
      error: 'Failed to generate token',
      message: error.message
    });
  }
});

// TwiML endpoint for voice calls
app.post('/voice', (req, res) => {
  const { requirement, name } = req.body;
  const VoiceResponse = twilio.twiml.VoiceResponse;
  const response = new VoiceResponse();

  console.log('Incoming call with requirement:', requirement, 'name:', name);

  // Check if requirement is about products
  if (requirement && requirement.includes('商品')) {
    // Connect to AI - pass requirement and name as URL parameters
    const connect = response.connect();
    const params = new URLSearchParams({
      requirement: requirement || '商品について',
      name: name || 'お客'
    });
    const url = `wss://${req.headers.host}/media-stream?${params.toString()}`;
    connect.stream({ url });
  } else {
    // Play guidance message
    response.say(
      {
        voice: 'Google.ja-JP-Neural2-B',
        language: 'ja-JP'
      },
      'お問い合わせありがとうございます。商品に関するお問い合わせは、お問い合わせ種別で「商品について」を選択してください。その他のお問い合わせについては、別途ご連絡させていただきます。'
    );
    response.hangup();
  }

  res.type('text/xml');
  res.send(response.toString());
});

// WebSocket server for media streaming
const server = app.listen(PORT, () => {
  console.log(`Server running on port ${PORT}`);
  console.log(`Access the app at http://localhost:${PORT}`);
});

const wss = new WebSocket.Server({ server, path: '/media-stream' });

wss.on('connection', (ws, req) => {
  console.log('Client connected to media stream');

  // Parse URL parameters
  const urlParams = new URLSearchParams(req.url.split('?')[1]);
  const requirement = urlParams.get('requirement') || '商品について';
  const customerName = urlParams.get('name') || 'お客';

  console.log('Connection params - Requirement:', requirement, 'Name:', customerName);

  let streamSid = null;
  let openAiWs = null;
  let functionCallData = {}; // Store function call data

  // Connect to OpenAI Realtime API
  const connectToOpenAI = () => {
    const url = 'wss://api.openai.com/v1/realtime?model=gpt-4o-realtime-preview-2024-12-17';
    openAiWs = new WebSocket(url, {
      headers: {
        'Authorization': `Bearer ${process.env.OPENAI_API_KEY}`,
        'OpenAI-Beta': 'realtime=v1'
      }
    });

    openAiWs.on('open', () => {
      console.log('Connected to OpenAI Realtime API');

      // Build custom instructions based on requirement
      const baseInstructions = `あなたはUnited Arrowsのカスタマーサービス担当者です。
お客様のお名前は${customerName}様です。
お問い合わせ種別: ${requirement}

`;

      const requirementInstructions = {
        '商品について': `商品に関するお問い合わせに丁寧に対応してください。

【対応フロー】
1. お客様がお探しの商品について詳細をお聞きする（商品名、カラー、サイズなど）
2. search_inventory関数を使用して在庫を確認する
3. 在庫がある場合、必ず「取り置きをされますか？」と確認する
4. お客様が取り置きを希望される場合、reserve_product関数を使用して取り置き処理を行う
5. 取り置きが完了したら、お客様に確認内容をお伝えし、「本日はUnited Arrowsをご利用いただきありがとうございました。それでは失礼いたします。」と丁寧に会話を終了する

在庫がない場合は、その旨をお伝えして、他の商品を提案するか、会話を終了してください。`,
        '配送について': `配送に関するお問い合わせに対応してください。
配送状況、配送方法、配送料金などについて案内してください。`,
        '返品・交換について': `返品・交換に関するお問い合わせに対応してください。
返品条件、交換手続きなどについて案内してください。`,
        'その他': `お客様のお問い合わせ内容を丁寧にお聞きして、適切に対応してください。`
      };

      const instructions = baseInstructions + (requirementInstructions[requirement] || requirementInstructions['その他']) + `\n\n日本語で自然で丁寧な会話を心がけてください。
まず、お客様に挨拶をして、どのようなご用件かお伺いしてください。`;

      // Configure session
      const sessionConfig = {
        type: 'session.update',
        session: {
          modalities: ['text', 'audio'],
          instructions: instructions,
          voice: 'shimmer',
          input_audio_format: 'g711_ulaw',
          output_audio_format: 'g711_ulaw',
          input_audio_transcription: {
            model: 'whisper-1'
          },
          turn_detection: {
            type: 'server_vad',
            threshold: 0.6,              // ノイズ感度を下げる（0.5→0.6）
            prefix_padding_ms: 200,      // 発話開始前のバッファを短縮（300→200）
            silence_duration_ms: 800     // 無音判定を長く（500→800）、短いノイズを無視
          },
          tools: [
            {
              type: 'function',
              name: 'search_inventory',
              description: '商品の在庫を検索します。商品名、カテゴリ、カラー、サイズで検索できます。',
              parameters: {
                type: 'object',
                properties: {
                  name: {
                    type: 'string',
                    description: '商品名（部分一致）'
                  },
                  category: {
                    type: 'string',
                    description: 'カテゴリ（トップス、ボトムス、アウター）'
                  },
                  color: {
                    type: 'string',
                    description: 'カラー'
                  },
                  size: {
                    type: 'string',
                    description: 'サイズ'
                  }
                }
              }
            },
            {
              type: 'function',
              name: 'reserve_product',
              description: '商品を取り置きします。お客様が取り置きを希望された場合に使用します。',
              parameters: {
                type: 'object',
                properties: {
                  product_id: {
                    type: 'string',
                    description: '商品ID（例: UA-001）'
                  },
                  product_name: {
                    type: 'string',
                    description: '商品名'
                  },
                  color: {
                    type: 'string',
                    description: 'カラー'
                  },
                  size: {
                    type: 'string',
                    description: 'サイズ'
                  },
                  customer_name: {
                    type: 'string',
                    description: 'お客様のお名前'
                  }
                },
                required: ['product_id', 'product_name', 'customer_name']
              }
            }
          ],
          tool_choice: 'auto'
        }
      };

      openAiWs.send(JSON.stringify(sessionConfig));
    });

    openAiWs.on('message', (data) => {
      try {
        const message = JSON.parse(data);

        // Log all message types for debugging
        if (message.type !== 'response.audio.delta' && message.type !== 'input_audio_buffer.speech_stopped') {
          console.log('OpenAI event:', message.type);
        }

        // Handle different event types
        switch (message.type) {
          case 'session.created':
            console.log('Session created:', message.type);
            break;

          case 'session.updated':
            console.log('Session updated - sending initial greeting');

            // Send initial greeting message
            const greetingMessage = {
              type: 'conversation.item.create',
              item: {
                type: 'message',
                role: 'user',
                content: [
                  {
                    type: 'input_text',
                    text: `こんにちは。${requirement}について問い合わせをしたいです。`
                  }
                ]
              }
            };

            openAiWs.send(JSON.stringify(greetingMessage));

            // Request AI response
            const responseRequest = {
              type: 'response.create'
            };

            openAiWs.send(JSON.stringify(responseRequest));
            break;

          case 'response.audio.delta':
            // Forward audio to Twilio
            if (message.delta && ws.readyState === WebSocket.OPEN) {
              const audioMessage = {
                event: 'media',
                streamSid: streamSid,
                media: {
                  payload: message.delta
                }
              };
              ws.send(JSON.stringify(audioMessage));
            }
            break;

          case 'response.output_item.added':
            if (message.item?.type === 'function_call') {
              console.log('Function call detected:', message.item.name);
              functionCallData[message.item.call_id] = {
                call_id: message.item.call_id,
                name: message.item.name
              };
            }
            break;

          case 'response.function_call_arguments.done':
            console.log('Function call arguments done:', message);
            const callData = functionCallData[message.call_id];
            if (callData) {
              callData.arguments = message.arguments;
              handleFunctionCall(callData, openAiWs, ws, streamSid, customerName);
              delete functionCallData[message.call_id];
            }
            break;

          case 'input_audio_buffer.speech_started':
            console.log('User started speaking - canceling AI response');

            // Cancel any ongoing AI response
            try {
              openAiWs.send(JSON.stringify({ type: 'response.cancel' }));
            } catch (err) {
              console.error('Error canceling response:', err);
            }

            // Clear Twilio audio queue
            if (ws.readyState === WebSocket.OPEN) {
              ws.send(JSON.stringify({ event: 'clear', streamSid: streamSid }));
            }
            break;

          case 'input_audio_buffer.speech_stopped':
            console.log('User stopped speaking');
            break;

          case 'input_audio_buffer.committed':
            console.log('Audio committed');
            break;

          case 'error':
            console.error('OpenAI error:', message);
            break;
        }
      } catch (error) {
        console.error('Error processing OpenAI message:', error);
      }
    });

    openAiWs.on('error', (error) => {
      console.error('OpenAI WebSocket error:', error);
    });

    openAiWs.on('close', () => {
      console.log('Disconnected from OpenAI');
    });
  };

  // Handle messages from Twilio
  ws.on('message', (message) => {
    try {
      const msg = JSON.parse(message);

      switch (msg.event) {
        case 'start':
          streamSid = msg.start.streamSid;
          console.log('Media stream started:', streamSid);
          connectToOpenAI();
          break;

        case 'media':
          // Forward audio to OpenAI
          if (openAiWs && openAiWs.readyState === WebSocket.OPEN) {
            const audioAppend = {
              type: 'input_audio_buffer.append',
              audio: msg.media.payload
            };
            openAiWs.send(JSON.stringify(audioAppend));
          }
          break;

        case 'stop':
          console.log('Media stream stopped');
          if (openAiWs) {
            openAiWs.close();
          }
          break;
      }
    } catch (error) {
      console.error('Error processing Twilio message:', error);
    }
  });

  ws.on('close', () => {
    console.log('Client disconnected');
    if (openAiWs) {
      openAiWs.close();
    }
  });
});

// Function to handle function calls
function handleFunctionCall(item, openAiWs, twilioWs, streamSid, customerName) {
  const { call_id, name, arguments: args } = item;

  console.log('Handling function call:', name, 'with args:', args);

  // Parse arguments safely
  let params = {};
  try {
    if (args) {
      if (typeof args === 'string') {
        params = args.trim() ? JSON.parse(args) : {};
      } else {
        params = args;
      }
    }
  } catch (parseError) {
    console.error('Error parsing arguments:', parseError);
    sendFunctionError(call_id, openAiWs, parseError.message);
    return;
  }

  console.log('Parsed params:', params);

  if (name === 'search_inventory') {
    handleSearchInventory(call_id, params, openAiWs);
  } else if (name === 'reserve_product') {
    handleReserveProduct(call_id, params, openAiWs, twilioWs, streamSid, customerName);
  }
}

// Handle search inventory
function handleSearchInventory(call_id, params, openAiWs) {
  try {
    const results = searchInventory(params);
    console.log('Search results:', JSON.stringify(results, null, 2));

    // Send function result back to OpenAI
    const functionOutput = {
      type: 'conversation.item.create',
      item: {
        type: 'function_call_output',
        call_id: call_id,
        output: JSON.stringify(results)
      }
    };

    openAiWs.send(JSON.stringify(functionOutput));
    openAiWs.send(JSON.stringify({ type: 'response.create' }));
  } catch (error) {
    console.error('Error handling search inventory:', error);
    sendFunctionError(call_id, openAiWs, error.message);
  }
}

// Handle reserve product
function handleReserveProduct(call_id, params, openAiWs, twilioWs, streamSid, customerName) {
  try {
    const { product_id, product_name, color, size } = params;
    const customer = params.customer_name || customerName;

    // Create reservation record
    const reservation = {
      reservation_id: `RES-${Date.now()}`,
      product_id,
      product_name,
      color: color || '指定なし',
      size: size || '指定なし',
      customer_name: customer,
      reserved_at: new Date().toISOString(),
      status: 'reserved'
    };

    console.log('===== 取り置き完了 =====');
    console.log(JSON.stringify(reservation, null, 2));
    console.log('========================');

    // Send success result back to OpenAI
    const functionOutput = {
      type: 'conversation.item.create',
      item: {
        type: 'function_call_output',
        call_id: call_id,
        output: JSON.stringify({
          success: true,
          reservation_id: reservation.reservation_id,
          message: `${product_name}（${color}、${size}）の取り置きが完了しました。`
        })
      }
    };

    openAiWs.send(JSON.stringify(functionOutput));
    openAiWs.send(JSON.stringify({ type: 'response.create' }));

    // Schedule call termination after AI finishes speaking
    setTimeout(() => {
      console.log('Terminating call after reservation...');
      if (twilioWs && twilioWs.readyState === WebSocket.OPEN) {
        // Send mark event to end the call gracefully
        twilioWs.send(JSON.stringify({
          event: 'mark',
          streamSid: streamSid,
          mark: {
            name: 'end_call'
          }
        }));

        // Close WebSocket connections
        setTimeout(() => {
          if (openAiWs && openAiWs.readyState === WebSocket.OPEN) {
            openAiWs.close();
          }
          if (twilioWs && twilioWs.readyState === WebSocket.OPEN) {
            twilioWs.close();
          }
        }, 3000); // Wait 3 seconds for AI to finish speaking
      }
    }, 5000); // Wait 5 seconds total
  } catch (error) {
    console.error('Error handling reserve product:', error);
    sendFunctionError(call_id, openAiWs, error.message);
  }
}

// Send error back to OpenAI
function sendFunctionError(call_id, openAiWs, errorMessage) {
  const errorOutput = {
    type: 'conversation.item.create',
    item: {
      type: 'function_call_output',
      call_id: call_id,
      output: JSON.stringify({ error: errorMessage })
    }
  };

  openAiWs.send(JSON.stringify(errorOutput));
  openAiWs.send(JSON.stringify({ type: 'response.create' }));
}

// Search inventory function
function searchInventory(params = {}) {
  const { name, category, color, size } = params;
  let results = [...inventoryData.products];

  if (name) {
    results = results.filter(p =>
      p.name.toLowerCase().includes(name.toLowerCase())
    );
  }

  if (category) {
    results = results.filter(p => p.category === category);
  }

  if (color) {
    results = results.filter(p => p.color.includes(color));
  }

  if (size) {
    results = results.filter(p => {
      const sizeStock = p.sizes[size];
      return sizeStock !== undefined && sizeStock > 0;
    });
  }

  // Format results
  return results.map(p => ({
    id: p.id,
    name: p.name,
    category: p.category,
    color: p.color.join(', '),
    availableSizes: Object.entries(p.sizes)
      .filter(([_, stock]) => stock > 0)
      .map(([size, stock]) => `${size}(在庫: ${stock})`)
      .join(', '),
    price: `¥${p.price.toLocaleString()}`
  }));
}
