/**
 * Search Inventory Function
 *
 * Searches product inventory based on various criteria.
 */

const fs = require('fs');
const path = require('path');

// Load inventory data
const inventoryData = JSON.parse(
  fs.readFileSync(path.join(__dirname, '../../data', 'inventory.json'), 'utf8')
);

/**
 * Normalize text for fuzzy matching (handles common variations)
 * @param {string} text - Text to normalize
 * @returns {string} Normalized text
 */
function normalizeText(text) {
  if (!text) return '';

  return text
    .toLowerCase()
    // カシミヤ → カシミア
    .replace(/カシミヤ/g, 'カシミア')
    .replace(/かしみや/g, 'カシミア')
    // その他の表記ゆれ
    .replace(/ウール/g, 'ウール')
    .replace(/うーる/g, 'ウール')
    // スペース除去
    .replace(/\s+/g, '');
}

/**
 * Search inventory based on search criteria
 * @param {Object} params - Search parameters
 * @param {string} [params.name] - Product name (partial match)
 * @param {string} [params.category] - Category (トップス, ボトムス, アウター)
 * @param {string} [params.color] - Color
 * @param {string} [params.size] - Size
 * @returns {Array} Array of matching products
 */
function searchInventory(params = {}) {
  const { name, category, color, size } = params;
  let results = [...inventoryData.products];

  // Filter by name (partial match with normalization)
  if (name) {
    const normalizedSearchName = normalizeText(name);
    results = results.filter(p =>
      normalizeText(p.name).includes(normalizedSearchName)
    );
  }

  // Filter by category (exact match)
  if (category) {
    results = results.filter(p => p.category === category);
  }

  // Filter by color (check if color is available)
  if (color) {
    results = results.filter(p => p.color.includes(color));
  }

  // Filter by size (check if size is available and has stock)
  if (size) {
    results = results.filter(p => {
      const sizeStock = p.sizes[size];
      return sizeStock !== undefined && sizeStock > 0;
    });
  }

  // Format results for AI
  return results.map(p => ({
    id: p.id,
    name: p.name,
    category: p.category,
    color: p.color.join(', '),
    availableSizes: Object.entries(p.sizes)
      .filter(([_, stock]) => stock > 0)
      .map(([size, stock]) => `${size}(在庫: ${stock})`)
      .join(', '),
    price: `¥${p.price.toLocaleString()}`
  }));
}

/**
 * Handle search inventory function call from OpenAI
 * @param {string} callId - Function call ID
 * @param {Object} params - Search parameters
 * @param {Object} openAiWs - OpenAI WebSocket connection
 */
function handleSearchInventory(callId, params, openAiWs) {
  try {
    const results = searchInventory(params);
    console.log('Search results:', JSON.stringify(results, null, 2));

    // Send function result back to OpenAI
    const functionOutput = {
      type: 'conversation.item.create',
      item: {
        type: 'function_call_output',
        call_id: callId,
        output: JSON.stringify(results)
      }
    };

    openAiWs.send(JSON.stringify(functionOutput));
    openAiWs.send(JSON.stringify({ type: 'response.create' }));
  } catch (error) {
    console.error('Error handling search inventory:', error);
    sendFunctionError(callId, openAiWs, error.message);
  }
}

/**
 * Send error response back to OpenAI
 * @param {string} callId - Function call ID
 * @param {Object} openAiWs - OpenAI WebSocket connection
 * @param {string} errorMessage - Error message
 */
function sendFunctionError(callId, openAiWs, errorMessage) {
  const errorOutput = {
    type: 'conversation.item.create',
    item: {
      type: 'function_call_output',
      call_id: callId,
      output: JSON.stringify({ error: errorMessage })
    }
  };

  openAiWs.send(JSON.stringify(errorOutput));
  openAiWs.send(JSON.stringify({ type: 'response.create' }));
}

module.exports = {
  searchInventory,
  handleSearchInventory
};
