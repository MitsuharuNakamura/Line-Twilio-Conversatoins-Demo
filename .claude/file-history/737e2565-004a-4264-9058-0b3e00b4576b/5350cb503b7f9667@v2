/**
 * OpenAI Realtime API Service
 *
 * Manages WebSocket connection to OpenAI Realtime API and handles events.
 */

const WebSocket = require('ws');
const { buildInstructions } = require('../config/instructions');
const { handleSearchInventory } = require('../functions/searchInventory');
const { handleReserveProduct } = require('../functions/reserveProduct');

/**
 * Create session configuration for OpenAI Realtime API
 * @param {string} customerName - Customer name
 * @param {string} requirement - Inquiry type
 * @returns {Object} Session configuration
 */
function createSessionConfig(customerName, requirement) {
  return {
    type: 'session.update',
    session: {
      modalities: ['text', 'audio'],
      instructions: buildInstructions(customerName, requirement),
      voice: 'shimmer',
      input_audio_format: 'g711_ulaw',
      output_audio_format: 'g711_ulaw',
      input_audio_transcription: {
        model: 'whisper-1'
      },
      turn_detection: {
        type: 'server_vad',
        threshold: 0.6,
        prefix_padding_ms: 200,
        silence_duration_ms: 800
      },
      tools: [
        {
          type: 'function',
          name: 'search_inventory',
          description: '商品の在庫を検索します。商品名、カテゴリ、カラー、サイズで検索できます。',
          parameters: {
            type: 'object',
            properties: {
              name: {
                type: 'string',
                description: '商品名（部分一致）'
              },
              category: {
                type: 'string',
                description: 'カテゴリ（トップス、ボトムス、アウター）'
              },
              color: {
                type: 'string',
                description: 'カラー'
              },
              size: {
                type: 'string',
                description: 'サイズ'
              }
            }
          }
        },
        {
          type: 'function',
          name: 'reserve_product',
          description: '商品を取り置きします。お客様が取り置きを希望された場合に使用します。',
          parameters: {
            type: 'object',
            properties: {
              product_id: {
                type: 'string',
                description: '商品ID（例: UA-001）'
              },
              product_name: {
                type: 'string',
                description: '商品名'
              },
              color: {
                type: 'string',
                description: 'カラー'
              },
              size: {
                type: 'string',
                description: 'サイズ'
              },
              customer_name: {
                type: 'string',
                description: 'お客様のお名前'
              }
            },
            required: ['product_id', 'product_name', 'customer_name']
          }
        }
      ],
      tool_choice: 'auto'
    }
  };
}

/**
 * Create initial greeting message
 * @param {string} requirement - Inquiry type
 * @returns {Object} Greeting message
 */
function createGreetingMessage(requirement) {
  return {
    type: 'conversation.item.create',
    item: {
      type: 'message',
      role: 'user',
      content: [
        {
          type: 'input_text',
          text: `こんにちは。${requirement}について問い合わせをしたいです。`
        }
      ]
    }
  };
}

/**
 * Connect to OpenAI Realtime API
 * @param {Object} twilioWs - Twilio WebSocket connection
 * @param {string} streamSid - Twilio stream SID
 * @param {string} customerName - Customer name
 * @param {string} requirement - Inquiry type
 * @returns {Object} OpenAI WebSocket connection and state
 */
function connectToOpenAI(twilioWs, streamSid, customerName, requirement) {
  const url = 'wss://api.openai.com/v1/realtime?model=gpt-4o-realtime-preview-2024-12-17';
  const openAiWs = new WebSocket(url, {
    headers: {
      'Authorization': `Bearer ${process.env.OPENAI_API_KEY}`,
      'OpenAI-Beta': 'realtime=v1'
    }
  });

  const state = {
    functionCallData: {},
    shouldTerminateAfterResponse: false
  };

  // Setup event handlers
  setupOpenAIEventHandlers(openAiWs, twilioWs, streamSid, customerName, requirement, state);

  return { openAiWs, state };
}

/**
 * Setup OpenAI WebSocket event handlers
 * @param {Object} openAiWs - OpenAI WebSocket connection
 * @param {Object} twilioWs - Twilio WebSocket connection
 * @param {string} streamSid - Twilio stream SID
 * @param {string} customerName - Customer name
 * @param {string} requirement - Inquiry type
 * @param {Object} state - Connection state
 */
function setupOpenAIEventHandlers(openAiWs, twilioWs, streamSid, customerName, requirement, state) {
  openAiWs.on('open', () => {
    console.log('Connected to OpenAI Realtime API');

    // Configure session
    const sessionConfig = createSessionConfig(customerName, requirement);
    openAiWs.send(JSON.stringify(sessionConfig));
  });

  openAiWs.on('message', (data) => {
    try {
      const message = JSON.parse(data);

      // Log all message types except audio delta
      if (message.type !== 'response.audio.delta' && message.type !== 'input_audio_buffer.speech_stopped') {
        console.log('OpenAI event:', message.type);
      }

      handleOpenAIEvent(message, openAiWs, twilioWs, streamSid, customerName, requirement, state);
    } catch (error) {
      console.error('Error processing OpenAI message:', error);
    }
  });

  openAiWs.on('error', (error) => {
    console.error('OpenAI WebSocket error:', error);
  });

  openAiWs.on('close', () => {
    console.log('Disconnected from OpenAI');
  });
}

/**
 * Handle OpenAI event
 * @param {Object} message - OpenAI event message
 * @param {Object} openAiWs - OpenAI WebSocket connection
 * @param {Object} twilioWs - Twilio WebSocket connection
 * @param {string} streamSid - Twilio stream SID
 * @param {string} customerName - Customer name
 * @param {string} requirement - Inquiry type
 * @param {Object} state - Connection state
 */
function handleOpenAIEvent(message, openAiWs, twilioWs, streamSid, customerName, requirement, state) {
  switch (message.type) {
    case 'session.created':
      console.log('Session created');
      break;

    case 'session.updated':
      console.log('Session updated - sending initial greeting');

      // Send initial greeting
      const greetingMessage = createGreetingMessage(requirement);
      openAiWs.send(JSON.stringify(greetingMessage));
      openAiWs.send(JSON.stringify({ type: 'response.create' }));
      break;

    case 'response.audio.delta':
      // Forward audio to Twilio
      if (message.delta && twilioWs.readyState === WebSocket.OPEN) {
        const audioMessage = {
          event: 'media',
          streamSid: streamSid,
          media: {
            payload: message.delta
          }
        };
        twilioWs.send(JSON.stringify(audioMessage));
      }
      break;

    case 'response.output_item.added':
      if (message.item?.type === 'function_call') {
        console.log('Function call detected:', message.item.name);
        state.functionCallData[message.item.call_id] = {
          call_id: message.item.call_id,
          name: message.item.name
        };
      }
      break;

    case 'response.function_call_arguments.done':
      console.log('Function call arguments done:', message);
      const callData = state.functionCallData[message.call_id];
      if (callData) {
        callData.arguments = message.arguments;
        handleFunctionCall(callData, openAiWs, customerName, state);
        delete state.functionCallData[message.call_id];
      }
      break;

    case 'input_audio_buffer.speech_started':
      console.log('User started speaking - canceling AI response');

      try {
        openAiWs.send(JSON.stringify({ type: 'response.cancel' }));
      } catch (err) {
        console.error('Error canceling response:', err);
      }

      // Clear Twilio audio queue
      if (twilioWs.readyState === WebSocket.OPEN) {
        twilioWs.send(JSON.stringify({ event: 'clear', streamSid: streamSid }));
      }
      break;

    case 'input_audio_buffer.speech_stopped':
      console.log('User stopped speaking');
      break;

    case 'input_audio_buffer.committed':
      console.log('Audio committed');
      break;

    case 'response.done':
      console.log('AI response completed');

      // Terminate call if flag is set
      if (state.shouldTerminateAfterResponse) {
        console.log('Terminating call after AI finished speaking...');

        setTimeout(() => {
          if (openAiWs && openAiWs.readyState === WebSocket.OPEN) {
            openAiWs.close();
          }
          if (twilioWs && twilioWs.readyState === WebSocket.OPEN) {
            twilioWs.close();
          }
        }, 2000);
      }
      break;

    case 'error':
      console.error('OpenAI error:', message);
      break;
  }
}

/**
 * Handle function call
 * @param {Object} item - Function call item
 * @param {Object} openAiWs - OpenAI WebSocket connection
 * @param {string} customerName - Customer name
 * @param {Object} state - Connection state
 */
function handleFunctionCall(item, openAiWs, customerName, state) {
  const { call_id, name, arguments: args } = item;

  console.log('Handling function call:', name, 'with args:', args);

  // Parse arguments safely
  let params = {};
  try {
    if (args) {
      if (typeof args === 'string') {
        params = args.trim() ? JSON.parse(args) : {};
      } else {
        params = args;
      }
    }
  } catch (parseError) {
    console.error('Error parsing arguments:', parseError);
    return;
  }

  console.log('Parsed params:', params);

  if (name === 'search_inventory') {
    handleSearchInventory(call_id, params, openAiWs);
  } else if (name === 'reserve_product') {
    handleReserveProduct(call_id, params, openAiWs, () => {
      state.shouldTerminateAfterResponse = true;
    });
  }
}

module.exports = {
  connectToOpenAI,
  createSessionConfig,
  createGreetingMessage
};
