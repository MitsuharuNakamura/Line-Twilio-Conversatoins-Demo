/**
 * Reserve Product Function
 *
 * Handles product reservation requests from customers.
 */

/**
 * Handle reserve product function call from OpenAI
 * @param {string} callId - Function call ID
 * @param {Object} params - Reservation parameters
 * @param {string} params.product_id - Product ID
 * @param {string} params.product_name - Product name
 * @param {string} [params.color] - Color
 * @param {string} [params.size] - Size
 * @param {string} params.customer_name - Customer name
 * @param {Object} openAiWs - OpenAI WebSocket connection
 * @param {Function} terminateCallback - Callback to set termination flag
 */
function handleReserveProduct(callId, params, openAiWs, terminateCallback) {
  try {
    const { product_id, product_name, color, size, customer_name } = params;

    // Create reservation record
    const reservation = {
      reservation_id: `RES-${Date.now()}`,
      product_id,
      product_name,
      color: color || '指定なし',
      size: size || '指定なし',
      customer_name,
      reserved_at: new Date().toISOString(),
      status: 'reserved'
    };

    // Log reservation (in production, save to database)
    console.log('===== 取り置き完了 =====');
    console.log(JSON.stringify(reservation, null, 2));
    console.log('========================');

    // Send success result back to OpenAI
    const functionOutput = {
      type: 'conversation.item.create',
      item: {
        type: 'function_call_output',
        call_id: callId,
        output: JSON.stringify({
          success: true,
          reservation_id: reservation.reservation_id,
          message: `${product_name}（${color}、${size}）の取り置きが完了しました。お客様には取り置き完了をお伝えして、丁寧に会話を終了してください。`
        })
      }
    };

    openAiWs.send(JSON.stringify(functionOutput));
    openAiWs.send(JSON.stringify({ type: 'response.create' }));

    // Set flag to terminate call after AI finishes this response
    if (terminateCallback) {
      terminateCallback();
    }
  } catch (error) {
    console.error('Error handling reserve product:', error);
    sendFunctionError(callId, openAiWs, error.message);
  }
}

/**
 * Send error response back to OpenAI
 * @param {string} callId - Function call ID
 * @param {Object} openAiWs - OpenAI WebSocket connection
 * @param {string} errorMessage - Error message
 */
function sendFunctionError(callId, openAiWs, errorMessage) {
  const errorOutput = {
    type: 'conversation.item.create',
    item: {
      type: 'function_call_output',
      call_id: callId,
      output: JSON.stringify({ error: errorMessage })
    }
  };

  openAiWs.send(JSON.stringify(errorOutput));
  openAiWs.send(JSON.stringify({ type: 'response.create' }));
}

module.exports = {
  handleReserveProduct
};
