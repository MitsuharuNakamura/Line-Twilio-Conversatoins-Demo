/* ============================================
   United Arrows Design System
   ============================================ */
:root {
  /* United Arrows Brand Colors - Sophisticated & Minimal */
  --color-primary: #000000;
  --color-primary-dark: #1a1a1a;
  --color-primary-light: #333333;
  --color-secondary: #666666;
  --color-accent: #c8a882; /* Elegant gold accent */

  --color-text-primary: #000000;
  --color-text-secondary: #666666;
  --color-text-light: #999999;
  --color-text-inverse: #ffffff;

  --color-background: #ffffff;
  --color-surface: #fafafa;
  --color-surface-dark: #f5f5f5;
  --color-border: #e0e0e0;
  --color-border-light: #f0f0f0;

  --color-success: #4a8c6f;
  --color-success-bg: #e8f5e9;
  --color-warning: #c8a882;
  --color-warning-bg: #fef9f3;
  --color-error: #c84545;
  --color-error-bg: #fef0f0;
  --color-info: #5a7a9a;
  --color-info-bg: #f0f4f8;

  /* Typography - Elegant & Clean */
  --font-family-base: 'Helvetica Neue', 'Arial', 'Hiragino Kaku Gothic ProN',
                      'Hiragino Sans', 'Meiryo', sans-serif;
  --font-family-heading: 'Futura', 'Helvetica Neue', 'Arial', sans-serif;

  --font-size-xs: 0.6875rem;   /* 11px */
  --font-size-sm: 0.8125rem;   /* 13px */
  --font-size-base: 0.875rem;  /* 14px */
  --font-size-lg: 1rem;        /* 16px */
  --font-size-xl: 1.125rem;    /* 18px */
  --font-size-2xl: 1.5rem;     /* 24px */
  --font-size-3xl: 2rem;       /* 32px */
  --font-size-4xl: 2.5rem;     /* 40px */

  --font-weight-light: 300;
  --font-weight-normal: 400;
  --font-weight-medium: 500;
  --font-weight-semibold: 600;
  --font-weight-bold: 700;

  --line-height-tight: 1.2;
  --line-height-normal: 1.6;
  --line-height-relaxed: 1.8;
  --letter-spacing-tight: -0.02em;
  --letter-spacing-normal: 0;
  --letter-spacing-wide: 0.05em;
  --letter-spacing-wider: 0.1em;

  /* Spacing - Generous & Balanced */
  --spacing-xs: 0.5rem;    /* 8px */
  --spacing-sm: 0.75rem;   /* 12px */
  --spacing-md: 1rem;      /* 16px */
  --spacing-lg: 1.5rem;    /* 24px */
  --spacing-xl: 2rem;      /* 32px */
  --spacing-2xl: 3rem;     /* 48px */
  --spacing-3xl: 4rem;     /* 64px */
  --spacing-4xl: 6rem;     /* 96px */

  /* Border Radius - Minimal */
  --radius-none: 0;
  --radius-sm: 2px;
  --radius-md: 4px;
  --radius-lg: 6px;

  /* Shadows - Subtle */
  --shadow-xs: 0 1px 2px 0 rgba(0, 0, 0, 0.03);
  --shadow-sm: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
  --shadow-md: 0 2px 8px 0 rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 4px 16px 0 rgba(0, 0, 0, 0.1);
  --shadow-xl: 0 8px 24px 0 rgba(0, 0, 0, 0.12);

  /* Transitions - Smooth */
  --transition-fast: 150ms cubic-bezier(0.4, 0, 0.2, 1);
  --transition-base: 250ms cubic-bezier(0.4, 0, 0.2, 1);
  --transition-slow: 350ms cubic-bezier(0.4, 0, 0.2, 1);

  /* Z-index layers */
  --z-base: 1;
  --z-dropdown: 1000;
  --z-sticky: 1020;
  --z-fixed: 1030;
  --z-modal-backdrop: 1040;
  --z-modal: 1050;
  --z-popover: 1060;
  --z-tooltip: 1070;
}

/* ============================================
   CSS Reset & Base Styles
   ============================================ */
*,
*::before,
*::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  font-size: 16px;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}

body {
  font-family: var(--font-family-base);
  font-size: var(--font-size-base);
  line-height: var(--line-height-normal);
  color: var(--color-text-primary);
  background: var(--color-surface);
  min-height: 100vh;
}

/* ============================================
   Accessibility
   ============================================ */
.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border-width: 0;
}

.skip-link {
  position: absolute;
  top: -40px;
  left: 0;
  background: var(--color-primary);
  color: var(--color-text-inverse);
  padding: var(--spacing-sm) var(--spacing-md);
  text-decoration: none;
  z-index: var(--z-tooltip);
  font-size: var(--font-size-sm);
}

.skip-link:focus {
  top: 0;
}

/* ============================================
   Container & Layout
   ============================================ */
.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: var(--spacing-2xl) var(--spacing-lg);
}

/* ============================================
   Header
   ============================================ */
.site-header {
  text-align: center;
  padding: var(--spacing-4xl) var(--spacing-lg) var(--spacing-3xl);
  background: var(--color-background);
  border-bottom: 1px solid var(--color-border-light);
}

.brand-name {
  font-family: var(--font-family-heading);
  font-size: clamp(var(--font-size-3xl), 5vw, var(--font-size-4xl));
  font-weight: var(--font-weight-light);
  letter-spacing: var(--letter-spacing-wider);
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-sm);
  text-transform: uppercase;
}

.subtitle {
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-normal);
  color: var(--color-text-secondary);
  letter-spacing: var(--letter-spacing-wide);
  text-transform: uppercase;
}

/* ============================================
   Main Content
   ============================================ */
.main-content {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--spacing-2xl);
  margin-bottom: var(--spacing-3xl);
  padding: var(--spacing-2xl) 0;
}

@media (max-width: 768px) {
  .main-content {
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
  }
}

/* ============================================
   Form Section & Info Panel
   ============================================ */
.form-section,
.info-panel {
  background: var(--color-background);
  border: 1px solid var(--color-border);
  padding: var(--spacing-2xl);
  transition: box-shadow var(--transition-base);
}

.form-section:hover,
.info-panel:hover {
  box-shadow: var(--shadow-md);
}

.form-section h2,
.info-panel h3 {
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-xl);
  font-weight: var(--font-weight-normal);
  font-size: var(--font-size-xl);
  letter-spacing: var(--letter-spacing-wide);
  text-transform: uppercase;
  border-bottom: 1px solid var(--color-border-light);
  padding-bottom: var(--spacing-md);
}

/* ============================================
   Form Styles
   ============================================ */
.form-group {
  margin-bottom: var(--spacing-xl);
}

.form-label {
  display: block;
  margin-bottom: var(--spacing-sm);
  font-weight: var(--font-weight-normal);
  color: var(--color-text-primary);
  font-size: var(--font-size-sm);
  letter-spacing: var(--letter-spacing-normal);
  text-transform: uppercase;
}

.required {
  color: var(--color-error);
  font-weight: var(--font-weight-normal);
}

.form-input,
.form-select {
  width: 100%;
  padding: var(--spacing-md);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-none);
  font-size: var(--font-size-base);
  font-family: inherit;
  color: var(--color-text-primary);
  background-color: var(--color-background);
  transition: all var(--transition-base);
  appearance: none;
}

.form-input:hover,
.form-select:hover {
  border-color: var(--color-text-secondary);
}

.form-input:focus,
.form-select:focus {
  outline: none;
  border-color: var(--color-primary);
  box-shadow: inset 0 0 0 1px var(--color-primary);
}

.form-input[aria-invalid="true"],
.form-select[aria-invalid="true"] {
  border-color: var(--color-error);
}

.form-input[aria-invalid="true"]:focus,
.form-select[aria-invalid="true"]:focus {
  box-shadow: inset 0 0 0 1px var(--color-error);
}

.form-select {
  background-image: url("data:image/svg+xml,%3Csvg width='10' height='6' viewBox='0 0 10 6' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L5 5L9 1' stroke='%23000000' stroke-width='1.5' stroke-linecap='square'/%3E%3C/svg%3E");
  background-repeat: no-repeat;
  background-position: right var(--spacing-md) center;
  padding-right: var(--spacing-2xl);
}

/* Error Messages */
.error-message {
  display: none;
  color: var(--color-error);
  font-size: var(--font-size-xs);
  margin-top: var(--spacing-xs);
  font-weight: var(--font-weight-normal);
  letter-spacing: var(--letter-spacing-normal);
}

.error-message:not(:empty) {
  display: block;
}

/* ============================================
   Call Button
   ============================================ */
.call-button {
  width: 100%;
  padding: var(--spacing-md) var(--spacing-xl);
  background: var(--color-primary);
  color: var(--color-text-inverse);
  border: 1px solid var(--color-primary);
  border-radius: var(--radius-none);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  letter-spacing: var(--letter-spacing-wider);
  text-transform: uppercase;
  cursor: pointer;
  transition: all var(--transition-base);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-sm);
  margin-top: var(--spacing-2xl);
  position: relative;
  overflow: hidden;
}

.call-button::before {
  content: '';
  position: absolute;
  inset: 0;
  background: var(--color-primary-light);
  opacity: 0;
  transition: opacity var(--transition-base);
}

.call-button:hover::before {
  opacity: 1;
}

.call-button:hover {
  transform: translateY(-1px);
  box-shadow: var(--shadow-md);
}

.call-button:active {
  transform: translateY(0);
}

.call-button:focus-visible {
  outline: 2px solid var(--color-primary);
  outline-offset: 2px;
}

.call-button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  transform: none;
}

.call-button:disabled::before {
  opacity: 0;
}

.button-icon,
#buttonText {
  position: relative;
  z-index: var(--z-base);
}

.button-icon {
  font-size: var(--font-size-xl);
}

/* Loading Spinner */
.loading-spinner {
  display: none;
  width: 16px;
  height: 16px;
  border: 2px solid rgba(255, 255, 255, 0.3);
  border-top-color: white;
  border-radius: 50%;
  animation: spin 0.6s linear infinite;
  position: relative;
  z-index: var(--z-base);
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.call-button[aria-busy="true"] .loading-spinner {
  display: block;
}

.call-button.calling .button-icon {
  animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.5;
  }
}

/* ============================================
   Status Messages
   ============================================ */
.status {
  margin-top: var(--spacing-lg);
  padding: var(--spacing-md);
  border-radius: var(--radius-none);
  text-align: center;
  font-weight: var(--font-weight-normal);
  font-size: var(--font-size-sm);
  display: none;
  animation: fadeIn var(--transition-base);
  letter-spacing: var(--letter-spacing-normal);
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.status.active {
  display: block;
}

.status.info {
  background-color: var(--color-info-bg);
  color: var(--color-info);
  border: 1px solid var(--color-info);
}

.status.success {
  background-color: var(--color-success-bg);
  color: var(--color-success);
  border: 1px solid var(--color-success);
}

.status.error {
  background-color: var(--color-error-bg);
  color: var(--color-error);
  border: 1px solid var(--color-error);
}

/* ============================================
   Info Panel
   ============================================ */
.instruction-list,
.note-list {
  margin-left: var(--spacing-lg);
  margin-bottom: var(--spacing-lg);
}

.instruction-list li,
.note-list li {
  margin-bottom: var(--spacing-md);
  line-height: var(--line-height-relaxed);
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);
}

.note-box {
  background-color: var(--color-warning-bg);
  border: 1px solid var(--color-warning);
  padding: var(--spacing-lg);
  margin-top: var(--spacing-xl);
}

.note-title {
  color: var(--color-text-primary);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-medium);
  margin-bottom: var(--spacing-md);
  letter-spacing: var(--letter-spacing-wide);
  text-transform: uppercase;
}

.note-list {
  margin-left: var(--spacing-lg);
  margin-bottom: 0;
}

/* ============================================
   Footer
   ============================================ */
.site-footer {
  text-align: center;
  padding: var(--spacing-2xl);
  border-top: 1px solid var(--color-border-light);
  background: var(--color-background);
}

.footer-text {
  color: var(--color-text-light);
  font-size: var(--font-size-xs);
  letter-spacing: var(--letter-spacing-normal);
}

/* ============================================
   Focus Styles for Accessibility
   ============================================ */
*:focus-visible {
  outline: 2px solid var(--color-primary);
  outline-offset: 2px;
}

/* ============================================
   Utility Classes
   ============================================ */
.text-center {
  text-align: center;
}

.uppercase {
  text-transform: uppercase;
}

/* ============================================
   Print Styles
   ============================================ */
@media print {
  body {
    background: white;
    color: black;
  }

  .call-button,
  .loading-spinner {
    display: none;
  }

  .site-header,
  .site-footer {
    border: none;
  }
}

/* ============================================
   High Contrast Mode Support
   ============================================ */
@media (prefers-contrast: high) {
  :root {
    --color-border: #000;
    --color-text-primary: #000;
  }
}

/* ============================================
   Reduced Motion Support
   ============================================ */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* ============================================
   Responsive Adjustments
   ============================================ */
@media (max-width: 768px) {
  .container {
    padding: var(--spacing-xl) var(--spacing-md);
  }

  .site-header {
    padding: var(--spacing-2xl) var(--spacing-md);
  }

  .form-section,
  .info-panel {
    padding: var(--spacing-xl);
  }
}
