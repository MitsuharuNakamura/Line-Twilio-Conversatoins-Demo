/**
 * United Arrows Demo - Server Entry Point
 *
 * Main server file that orchestrates all components.
 */

require('dotenv').config();
const express = require('express');
const { validateEnv } = require('./src/utils/validateEnv');
const { setupMediaStreamWebSocket } = require('./src/websocket/mediaStream');
const apiRoutes = require('./src/routes/api');
const voiceRoutes = require('./src/routes/voice');

// Validate environment variables
validateEnv();

// Initialize Express app
const app = express();
const PORT = process.env.PORT || 3000;

// Middleware
app.use(express.json());
app.use(express.urlencoded({ extended: true }));
app.use(express.static('public'));

// Routes
app.use('/api', apiRoutes);
app.use('/', voiceRoutes);

// Start server
const server = app.listen(PORT, () => {
  console.log(`Server running on port ${PORT}`);
  console.log(`Access the app at http://localhost:${PORT}`);
});

// Setup WebSocket for media streaming
setupMediaStreamWebSocket(server);

// Graceful shutdown
process.on('SIGTERM', () => {
  console.log('SIGTERM received, shutting down gracefully...');
  server.close(() => {
    console.log('Server closed');
    process.exit(0);
  });
});

process.on('SIGINT', () => {
  console.log('\nSIGINT received, shutting down gracefully...');
  server.close(() => {
    console.log('Server closed');
    process.exit(0);
  });
});
