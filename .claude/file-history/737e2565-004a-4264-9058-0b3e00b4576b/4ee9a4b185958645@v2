/**
 * Voice Routes
 *
 * Handles Twilio Voice webhooks and TwiML generation.
 */

const express = require('express');
const router = express.Router();
const { generateTwiML } = require('../services/twilio');

/**
 * POST /voice
 * TwiML endpoint for voice calls
 */
router.post('/voice', (req, res) => {
  const { requirement, name } = req.body;

  console.log('Incoming call with requirement:', requirement, 'name:', name);

  try {
    const twiml = generateTwiML(requirement, name, req.headers.host);

    res.type('text/xml');
    res.send(twiml);
  } catch (error) {
    console.error('Error generating TwiML:', error);
    res.status(500).send('Internal Server Error');
  }
});

module.exports = router;
